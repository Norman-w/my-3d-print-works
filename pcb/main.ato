"""SmartPaddle rigid PCB logic.

This file is the intended source of truth for electrical connectivity.
KiCad-side scripts may maintain mechanical reference drawings, edge cuts,
and special generated pads, but nets should be mirrored from here instead of
being invented inside geometry scripts.
"""

from "parts.ato" import Resistor
from "parts.ato" import Capacitor
from "parts.ato" import Diode
from "parts.ato" import Schottky1A_SOD123
from "parts.ato" import BAT54S
from "parts.ato" import PChannelMOSFET_SOT23
from "parts.ato" import NChannelMOSFET_SOT23
from "parts.ato" import AP2112K_3V3
from "parts.ato" import WirePad
from "parts.ato" import SmallWirePad
from "parts.ato" import EdgeFingerPad
from "parts.ato" import LED_0603
from "parts.ato" import TactileSwitch45


component SGFK_ESP32C6N8_Cutout:
    """SGFK ESP32-C6-N8 半孔映射（天线 −X；pin1–14 在 −Y 拍柄/IMU 侧；pin15–28 在 +Y）。

    实物确认：拍柄侧为 GND/3V3/EN/IO4…；对侧为 IO2/IO3/UART0。
    IMU UART1 → IO4/IO5（pad 4/5，贴 IMU）；PZT TL/TR → IO2/IO3（对侧）；BL/BR 仍 IO6/7。
    """
    designator_prefix = "J"
    pin GND_1
    pin VCC_3V3
    pin EN
    pin GPIO4_IMU_TX
    pin GPIO5_IMU_RX
    pin GPIO6_PZT_BL
    pin GPIO7_PZT_BR
    pin GPIO8_LED_DATA
    pin GPIO9_BOOT
    # pad 11 = GPIO10 → 电源自锁；pad 16 = GPIO18 → 尾部读键（勿再叫 GPIO10）
    pin GPIO18_USER_BTN
    pin PWR_LATCH
    pin USB_DN
    pin USB_DP
    pin UART_RX
    pin UART_TX
    pin GPIO3_PZT_TR
    pin GPIO2_PZT_TL
    pin GND_28

    GND_1 ~ pin 1
    VCC_3V3 ~ pin 2
    EN ~ pin 3
    GPIO4_IMU_TX ~ pin 4
    GPIO5_IMU_RX ~ pin 5
    GPIO6_PZT_BL ~ pin 6
    GPIO7_PZT_BR ~ pin 7
    GPIO8_LED_DATA ~ pin 10
    PWR_LATCH ~ pin 11
    USB_DN ~ pin 13
    USB_DP ~ pin 14
    GPIO9_BOOT ~ pin 15
    GPIO18_USER_BTN ~ pin 16
    UART_RX ~ pin 24
    UART_TX ~ pin 25
    GPIO3_PZT_TR ~ pin 26
    GPIO2_PZT_TL ~ pin 27
    GND_28 ~ pin 28
    footprint = "SmartPaddle:SGFK_ESP32-C6-N8_CUTOUT"

component IM948_Cutout:
    designator_prefix = "U"
    pin GND_1
    pin GND_8
    pin VBUS
    pin VBAT_3
    pin VDDIO
    pin ADIN
    pin LED_B
    pin LED_R
    pin GPIO
    pin KEY
    pin RXD
    pin TXD
    pin VBAT_15
    pin GND_16

    GND_1 ~ pin 1
    VBUS ~ pin 2
    VBAT_3 ~ pin 3
    VDDIO ~ pin 4
    ADIN ~ pin 7
    GND_8 ~ pin 8
    LED_B ~ pin 9
    LED_R ~ pin 10
    GPIO ~ pin 11
    KEY ~ pin 12
    RXD ~ pin 13
    TXD ~ pin 14
    VBAT_15 ~ pin 15
    GND_16 ~ pin 16
    footprint = "SmartPaddle:IM948_CUTOUT"

module PZTDock:
    pin SIGNAL_PAD
    pin GND_PAD
    pin MCU_SIGNAL
    pin CLAMP_GND
    pin CLAMP_VCC

    signal pzt_raw
    signal pzt_mcu
    signal gnd
    signal vcc

    SIGNAL_PAD ~ pzt_raw
    MCU_SIGNAL ~ pzt_mcu
    GND_PAD ~ gnd
    CLAMP_GND ~ gnd
    CLAMP_VCC ~ vcc

    pzt_signal_pad = new WirePad
    pzt_gnd_pad = new WirePad
    series_resistor = new Resistor
    bleed_resistor = new Resistor
    clamp_diode = new BAT54S
    series_resistor.value = "4.7k"
    bleed_resistor.value = "1M"

    pzt_signal_pad.contact ~ SIGNAL_PAD
    pzt_gnd_pad.contact ~ GND_PAD
    series_resistor.p1 ~ pzt_raw
    series_resistor.p2 ~ MCU_SIGNAL
    bleed_resistor.p1 ~ pzt_raw
    bleed_resistor.p2 ~ CLAMP_GND
    clamp_diode.signal_node ~ MCU_SIGNAL
    clamp_diode.low_rail ~ CLAMP_GND
    clamp_diode.high_rail ~ CLAMP_VCC



module TailHarness5P2S:
    """Ten independent, double-sided 1.27 mm edge fingers at the handle tip."""
    pin VBAT
    pin GND
    pin LED_PLUS
    pin LED_DIN
    pin BUTTON
    pin USB_VBUS
    pin USB_DP
    pin USB_DN
    pin UART_TX
    pin UART_RX

    power_finger = new EdgeFingerPad;  power_finger.front ~ VBAT; power_finger.back ~ GND
    led_finger = new EdgeFingerPad;    led_finger.front ~ LED_PLUS; led_finger.back ~ LED_DIN
    control_finger = new EdgeFingerPad; control_finger.front ~ BUTTON; control_finger.back ~ USB_VBUS
    usb_finger = new EdgeFingerPad;    usb_finger.front ~ USB_DP; usb_finger.back ~ USB_DN
    uart_finger = new EdgeFingerPad;   uart_finger.front ~ UART_TX; uart_finger.back ~ UART_RX



module PowerLatchAndRegulator:
    """软开关 + LDO。
    V3：开机拉低 P_GATE 与 MCU 读键用二极管隔离；LDO 电源 OR 用 1A 肖特基（SS14）。
    """
    pin VBAT_IN
    pin VBAT_SW
    pin VCC_3V3
    pin GND
    pin EN
    pin PWR_LATCH
    pin BUTTON_RAW
    pin BUTTON_GPIO
    pin P_GATE
    pin USB_VBUS

    q_power = new PChannelMOSFET_SOT23
    q_latch = new NChannelMOSFET_SOT23
    r_gate = new Resistor
    r_button_series = new Resistor
    r_latch_pd = new Resistor
    r_en_pullup = new Resistor
    # 开机隔离：阳极→P_GATE，阴极→BUTTON_RAW；按下按键时把门极拉低，不把 VBAT 灌进 MCU
    d_btn_start = new Diode
    d_ldo_bat = new Schottky1A_SOD123
    d_ldo_usb = new Schottky1A_SOD123
    ldo = new AP2112K_3V3
    c_in = new Capacitor
    c_out = new Capacitor
    r_gate.value = "100k"
    r_button_series.value = "1k"
    r_latch_pd.value = "100k"
    r_en_pullup.value = "10k"
    d_btn_start.value = "1N4148W"
    d_ldo_bat.value = "SS14"
    d_ldo_usb.value = "SS14"
    c_in.value = "10uF"
    c_out.value = "10uF"

    signal ldo_vin

    q_power.gate ~ P_GATE
    q_power.source ~ VBAT_IN
    q_power.drain ~ VBAT_SW

    q_latch.gate ~ PWR_LATCH
    q_latch.source ~ GND
    q_latch.drain ~ P_GATE

    r_gate.p1 ~ P_GATE
    r_gate.p2 ~ VBAT_IN

    d_btn_start.anode ~ P_GATE
    d_btn_start.cathode ~ BUTTON_RAW
    # MCU 读键：经 1k 看 BUTTON_RAW；上电后用内部上拉（高=松开，低=按下）
    r_button_series.p1 ~ BUTTON_RAW
    r_button_series.p2 ~ BUTTON_GPIO

    r_latch_pd.p1 ~ PWR_LATCH
    r_latch_pd.p2 ~ GND
    r_en_pullup.p1 ~ EN
    r_en_pullup.p2 ~ VCC_3V3

    # USB 5V 与电池开关轨二极管或，只喂 LDO（不灌 VBAT_SW）
    d_ldo_bat.anode ~ VBAT_SW
    d_ldo_bat.cathode ~ ldo_vin
    d_ldo_usb.anode ~ USB_VBUS
    d_ldo_usb.cathode ~ ldo_vin
    ldo.vin ~ ldo_vin
    ldo.en ~ ldo_vin
    ldo.gnd ~ GND
    ldo.vout ~ VCC_3V3

    c_in.p1 ~ ldo_vin
    c_in.p2 ~ GND
    c_out.p1 ~ VCC_3V3
    c_out.p2 ~ GND



module LEDInterface:
    pin LED_SUPPLY
    pin MCU_DATA
    pin LED_DIN
    pin GND

    r_data = new Resistor
    c_supply = new Capacitor
    r_data.value = "330R"
    c_supply.value = "100nF"

    r_data.p1 ~ MCU_DATA
    r_data.p2 ~ LED_DIN
    c_supply.p1 ~ LED_SUPPLY
    c_supply.p2 ~ GND



module TestPads:
    """Bringup 测试点：GND / 3V3 / VBAT_SW / TP_MCU_EN / TP_MCU_BOOT。"""
    pin GND
    pin VCC_3V3
    pin VBAT_SW
    pin EN
    pin BOOT

    gnd_pad = new SmallWirePad;   gnd_pad.contact ~ GND
    vcc_pad = new SmallWirePad;   vcc_pad.contact ~ VCC_3V3
    vbat_pad = new SmallWirePad;  vbat_pad.contact ~ VBAT_SW
    tp_mcu_en = new SmallWirePad; tp_mcu_en.contact ~ EN
    tp_mcu_boot = new SmallWirePad; tp_mcu_boot.contact ~ BOOT


module McuDebugControls:
    """宽栈道 BOOT/EN 轻触：按下分别把 BOOT、EN 拉到 GND。"""
    pin BOOT
    pin EN
    pin GND

    sw_boot = new TactileSwitch45
    sw_en = new TactileSwitch45
    sw_boot.a ~ BOOT
    sw_boot.b ~ GND
    sw_en.a ~ EN
    sw_en.b ~ GND


module McuPowerLed:
    """MCU 旁可选 0603 电源指示（可 DNP）。"""
    pin VCC_3V3
    pin GND

    led = new LED_0603
    r_lim = new Resistor
    r_lim.value = "1k"
    led.a ~ VCC_3V3
    led.c ~ r_lim.p1
    r_lim.p2 ~ GND


module BatterySense:
    pin VBAT_SW
    pin GND
    pin SENSE

    r_top = new Resistor
    r_bottom = new Resistor
    c_filter = new Capacitor
    r_top.value = "1M"
    r_bottom.value = "1M"
    c_filter.value = "100nF"

    r_top.p1 ~ VBAT_SW
    r_top.p2 ~ SENSE
    r_bottom.p1 ~ SENSE
    r_bottom.p2 ~ GND
    c_filter.p1 ~ SENSE
    c_filter.p2 ~ GND



module SmartPaddleRigid:
    mcu = new SGFK_ESP32C6N8_Cutout
    imu = new IM948_Cutout
    power = new PowerLatchAndRegulator
    tail = new TailHarness5P2S
    bringup = new TestPads
    debug_sw = new McuDebugControls
    pwr_led = new McuPowerLed
    battery = new BatterySense

    # Inline LED interface components (atopile 0.2.x module nesting bug workaround)
    led_r_data = new Resistor
    led_c_supply = new Capacitor
    led_r_data.value = "330R"
    led_c_supply.value = "100nF"

    pzt_tr = new PZTDock
    pzt_tl = new PZTDock
    pzt_br = new PZTDock
    pzt_bl = new PZTDock

    signal gnd
    signal vbat_in
    signal vbat_sw
    signal vcc
    signal en
    signal usb_dp
    signal usb_dn
    signal uart_tx
    signal uart_rx
    signal imu_uart_tx
    signal imu_uart_rx
    signal led_data
    signal led_din
    signal btn_sw
    signal boot_btn
    signal user_btn
    signal pwr_latch
    signal p_gate
    signal imu_key
    signal imu_gpio
    signal vbat_sense
    signal vbus

    signal pzt_tr_signal
    signal pzt_tl_signal
    signal pzt_br_signal
    signal pzt_bl_signal

    # Power rails.
    tail.VBAT ~ vbat_in
    tail.GND ~ gnd
    power.VBAT_IN ~ vbat_in
    power.VBAT_SW ~ vbat_sw
    power.VCC_3V3 ~ vcc
    power.GND ~ gnd
    power.USB_VBUS ~ vbus
    mcu.VCC_3V3 ~ vcc
    mcu.GND_1 ~ gnd
    mcu.GND_28 ~ gnd

    # IM948：独占 UART1（IO2/IO3），与 MCU UART0 / 尾插调试口隔离。
    imu.VBAT_3 ~ vbat_sw
    imu.VBAT_15 ~ vbat_sw
    imu.VBUS ~ vbus
    imu.GND_1 ~ gnd
    imu.GND_8 ~ gnd
    imu.GND_16 ~ gnd
    # VDDIO 悬空：锂电(~3.7V)供电时由模块内部产生约 3.0V；勿接 3V3 以免对顶
    imu.ADIN ~ vbat_sense
    imu.RXD ~ imu_uart_tx
    imu.TXD ~ imu_uart_rx
    imu.KEY ~ imu_key
    imu.GPIO ~ imu_gpio
    mcu.GPIO4_IMU_TX ~ imu_uart_tx
    mcu.GPIO5_IMU_RX ~ imu_uart_rx

    # ESP32-C6 control, programming, and user input.
    mcu.EN ~ en
    power.EN ~ en
    mcu.GPIO9_BOOT ~ boot_btn
    mcu.GPIO18_USER_BTN ~ user_btn
    mcu.PWR_LATCH ~ pwr_latch
    power.PWR_LATCH ~ pwr_latch
    power.P_GATE ~ p_gate
    tail.BUTTON ~ btn_sw
    power.BUTTON_RAW ~ btn_sw
    power.BUTTON_GPIO ~ user_btn

    # 宽栈道 BOOT/EN 键 + TP；MCU 旁可选电源灯。
    debug_sw.BOOT ~ boot_btn
    debug_sw.EN ~ en
    debug_sw.GND ~ gnd
    pwr_led.VCC_3V3 ~ vcc
    pwr_led.GND ~ gnd

    # USB Serial/JTAG + 尾插 UART0 调试（不并 IMU）。
    tail.USB_VBUS ~ vbus
    tail.USB_DP ~ usb_dp
    tail.USB_DN ~ usb_dn
    tail.UART_TX ~ uart_tx
    tail.UART_RX ~ uart_rx
    mcu.USB_DP ~ usb_dp
    mcu.USB_DN ~ usb_dn
    mcu.UART_TX ~ uart_tx
    mcu.UART_RX ~ uart_rx

    # External WS2812B-style LED wire interface.
    tail.LED_PLUS ~ vbat_sw
    tail.LED_DIN ~ led_din
    led_c_supply.p1 ~ vbat_sw
    led_c_supply.p2 ~ gnd
    led_r_data.p1 ~ led_data
    led_r_data.p2 ~ led_din
    mcu.GPIO8_LED_DATA ~ led_data

    battery.VBAT_SW ~ vbat_sw
    battery.GND ~ gnd
    battery.SENSE ~ vbat_sense

    bringup.VBAT_SW ~ vbat_sw
    bringup.VCC_3V3 ~ vcc
    bringup.GND ~ gnd
    bringup.EN ~ en
    bringup.BOOT ~ boot_btn

    # PZT：TL/TR 用对侧 IO2/IO3；BL/BR 仍在拍柄侧 IO6/IO7。
    mcu.GPIO3_PZT_TR ~ pzt_tr_signal
    pzt_tr.MCU_SIGNAL ~ pzt_tr_signal
    pzt_tr.gnd ~ gnd
    pzt_tr.vcc ~ vcc

    mcu.GPIO2_PZT_TL ~ pzt_tl_signal
    pzt_tl.MCU_SIGNAL ~ pzt_tl_signal
    pzt_tl.gnd ~ gnd
    pzt_tl.vcc ~ vcc

    mcu.GPIO7_PZT_BR ~ pzt_br_signal
    pzt_br.MCU_SIGNAL ~ pzt_br_signal
    pzt_br.gnd ~ gnd
    pzt_br.vcc ~ vcc

    mcu.GPIO6_PZT_BL ~ pzt_bl_signal
    pzt_bl.MCU_SIGNAL ~ pzt_bl_signal
    pzt_bl.gnd ~ gnd
    pzt_bl.vcc ~ vcc
