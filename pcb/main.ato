"""SmartPaddle rigid PCB logic.

This file is the intended source of truth for electrical connectivity.
KiCad-side scripts may maintain mechanical reference drawings, edge cuts,
and special generated pads, but nets should be mirrored from here instead of
being invented inside geometry scripts.
"""

from "parts.ato" import Resistor
from "parts.ato" import Capacitor
from "parts.ato" import Diode
from "parts.ato" import BAT54S
from "parts.ato" import PChannelMOSFET_SOT23
from "parts.ato" import NChannelMOSFET_SOT23
from "parts.ato" import AP2112K_3V3
from "parts.ato" import WirePad
from "parts.ato" import SmallWirePad
from "parts.ato" import MolexPicoBlade_53261_5P
from "parts.ato" import LED_0603
from "parts.ato" import TactileSwitch45


component SGFK_ESP32C6N8_Cutout:
    """SGFK ESP32-C6-N8 半孔映射 — 真理源 pcb/lib/esp32c6n8/pinmap.py。

    顶视（元件面）：天线 −X；pin1–14 在 +Y（拍柄）；pin15–28 在 −Y（拍头/IMU）。
    拍柄丝印 GND/3V3/EN/IO4…；拍头侧 IO9/BOOT…IO2/IO3/UART0/GND。
    勿按模块背面丝印抄坐标。改脚位只改 pinmap.py → generate + validate。
    """
    designator_prefix = "J"
    pin GND_1
    pin VCC_3V3
    pin EN
    # IMU UART1：pad21 IO23=TX、pad20 IO22=RX（拍头侧，与 IM948 RXD/TXD 面对面平行交叉）
    pin GPIO23_IMU_TX
    pin GPIO22_IMU_RX
    pin GPIO6_PZT_BL
    pin GPIO7_PZT_BR
    pin GPIO8_LED_DATA
    pin GPIO9_BOOT
    # pad 11 = GPIO10 → 电源自锁；pad 16 = GPIO18 → 尾部读键（勿再叫 GPIO10）
    pin GPIO18_USER_BTN
    pin PWR_LATCH
    pin USB_DN
    pin USB_DP
    pin UART_RX
    pin UART_TX
    pin GPIO3_PZT_TR
    pin GPIO2_PZT_TL
    pin GND_28

    # 绑定与 pcb/lib/esp32c6n8/pinmap.py PROJECT_BINDINGS 一一对应（validate 脚本会核对）
    GND_1 ~ pin 1
    VCC_3V3 ~ pin 2
    EN ~ pin 3
    GPIO6_PZT_BL ~ pin 6
    GPIO7_PZT_BR ~ pin 7
    GPIO8_LED_DATA ~ pin 10
    PWR_LATCH ~ pin 11
    USB_DN ~ pin 13
    USB_DP ~ pin 14
    GPIO9_BOOT ~ pin 15
    GPIO18_USER_BTN ~ pin 16
    GPIO22_IMU_RX ~ pin 20
    GPIO23_IMU_TX ~ pin 21
    UART_RX ~ pin 24
    UART_TX ~ pin 25
    GPIO3_PZT_TR ~ pin 26
    GPIO2_PZT_TL ~ pin 27
    GND_28 ~ pin 28
    footprint = "SmartPaddle:SGFK_ESP32-C6-N8_CUTOUT"

component IM948_Cutout:
    designator_prefix = "U"
    pin GND_1
    pin GND_8
    pin VBUS
    pin VBAT_3
    pin VDDIO
    pin ADIN
    pin LED_B
    pin LED_R
    pin GPIO
    pin KEY
    pin RXD
    pin TXD
    pin VBAT_15
    pin GND_16

    GND_1 ~ pin 1
    VBUS ~ pin 2
    VBAT_3 ~ pin 3
    VDDIO ~ pin 4
    ADIN ~ pin 7
    GND_8 ~ pin 8
    LED_B ~ pin 9
    LED_R ~ pin 10
    GPIO ~ pin 11
    KEY ~ pin 12
    RXD ~ pin 13
    TXD ~ pin 14
    VBAT_15 ~ pin 15
    GND_16 ~ pin 16
    footprint = "SmartPaddle:IM948_CUTOUT"

module PZTDock:
    pin SIGNAL_PAD
    pin GND_PAD
    pin MCU_SIGNAL
    pin CLAMP_GND
    pin CLAMP_VCC

    signal pzt_raw
    signal pzt_mcu
    signal gnd
    signal vcc

    SIGNAL_PAD ~ pzt_raw
    MCU_SIGNAL ~ pzt_mcu
    GND_PAD ~ gnd
    CLAMP_GND ~ gnd
    CLAMP_VCC ~ vcc

    pzt_signal_pad = new WirePad
    pzt_gnd_pad = new WirePad
    series_resistor = new Resistor
    bleed_resistor = new Resistor
    clamp_diode = new BAT54S
    series_resistor.value = "4.7k"
    bleed_resistor.value = "1M"

    pzt_signal_pad.contact ~ SIGNAL_PAD
    pzt_gnd_pad.contact ~ GND_PAD
    series_resistor.p1 ~ pzt_raw
    series_resistor.p2 ~ MCU_SIGNAL
    bleed_resistor.p1 ~ pzt_raw
    bleed_resistor.p2 ~ CLAMP_GND
    clamp_diode.signal_node ~ MCU_SIGNAL
    clamp_diode.low_rail ~ CLAMP_GND
    clamp_diode.high_rail ~ CLAMP_VCC



module TailHarness5P2S:
    """柄尾 MX1.25 卧贴：正反各 1×5P（Molex PicoBlade 53261-0571）。

    正面 = 原金手指 F 侧；背面 = 原金手指 B 侧。
    SYS_5V_IN=充电总成 5V OUT；BAT_CELL_P=可选电芯 B+ 采样（非 5V）。
    烧录走 USB D+/D−；充电仓 Type-C 通常无 D+/D−。
    引脚表：docs/1.25x10p/README.md
    """
    pin SYS_5V_IN
    pin GND
    pin LED_PLUS
    pin LED_DIN
    pin BUTTON
    pin BAT_CELL_P
    pin USB_DP
    pin USB_DN
    pin UART_TX
    pin UART_RX

    conn_f = new MolexPicoBlade_53261_5P
    conn_f.p1 ~ SYS_5V_IN
    conn_f.p2 ~ LED_PLUS
    conn_f.p3 ~ BUTTON
    conn_f.p4 ~ USB_DP
    conn_f.p5 ~ UART_TX

    conn_b = new MolexPicoBlade_53261_5P
    conn_b.p1 ~ GND
    conn_b.p2 ~ LED_DIN
    conn_b.p3 ~ BAT_CELL_P
    conn_b.p4 ~ USB_DN
    conn_b.p5 ~ UART_RX



module PowerLatchAndRegulator:
    """软开关 + LDO（V4 最简可靠）。
    唯一系统输入：充电总成 5V OUT → SYS_5V_IN → PMOS → SYS_5V_SW → AP2112。
    不做 USB/电池二极管或；按键开机与 MCU 读键仍用 1N4148W 隔离。
    """
    pin SYS_5V_IN
    pin SYS_5V_SW
    pin VCC_3V3
    pin GND
    pin EN
    pin PWR_LATCH
    pin BUTTON_RAW
    pin BUTTON_GPIO
    pin P_GATE

    q_power = new PChannelMOSFET_SOT23
    q_latch = new NChannelMOSFET_SOT23
    r_gate = new Resistor
    r_button_series = new Resistor
    r_latch_pd = new Resistor
    r_en_pullup = new Resistor
    # 开机隔离：阳极→P_GATE，阴极→BUTTON_RAW
    d_btn_start = new Diode
    ldo = new AP2112K_3V3
    c_in = new Capacitor
    c_out = new Capacitor
    r_gate.value = "100k"
    r_button_series.value = "1k"
    r_latch_pd.value = "100k"
    r_en_pullup.value = "10k"
    d_btn_start.value = "1N4148W"
    c_in.value = "10uF"
    c_out.value = "10uF"

    q_power.gate ~ P_GATE
    q_power.source ~ SYS_5V_IN
    q_power.drain ~ SYS_5V_SW

    q_latch.gate ~ PWR_LATCH
    q_latch.source ~ GND
    q_latch.drain ~ P_GATE

    r_gate.p1 ~ P_GATE
    r_gate.p2 ~ SYS_5V_IN

    d_btn_start.anode ~ P_GATE
    d_btn_start.cathode ~ BUTTON_RAW
    r_button_series.p1 ~ BUTTON_RAW
    r_button_series.p2 ~ BUTTON_GPIO

    r_latch_pd.p1 ~ PWR_LATCH
    r_latch_pd.p2 ~ GND
    r_en_pullup.p1 ~ EN
    r_en_pullup.p2 ~ VCC_3V3

    # 开关后的 5V 直接进 LDO（充电总成已升压，无 OR 二极管压降问题）
    ldo.vin ~ SYS_5V_SW
    ldo.en ~ SYS_5V_SW
    ldo.gnd ~ GND
    ldo.vout ~ VCC_3V3

    c_in.p1 ~ SYS_5V_SW
    c_in.p2 ~ GND
    c_out.p1 ~ VCC_3V3
    c_out.p2 ~ GND



module LEDInterface:
    pin LED_SUPPLY
    pin MCU_DATA
    pin LED_DIN
    pin GND

    r_data = new Resistor
    c_supply = new Capacitor
    r_data.value = "330R"
    c_supply.value = "100nF"

    r_data.p1 ~ MCU_DATA
    r_data.p2 ~ LED_DIN
    c_supply.p1 ~ LED_SUPPLY
    c_supply.p2 ~ GND



module TestPads:
    """Bringup 大陆测试焊盘：TP_3V3 / TP_SYS_5V_SW / TP_GND。BOOT/EN/开机用宽栈道轻触。"""
    pin VCC_3V3
    pin SYS_5V_SW
    pin GND

    vcc_pad = new SmallWirePad;   vcc_pad.contact ~ VCC_3V3
    sys5_pad = new SmallWirePad;  sys5_pad.contact ~ SYS_5V_SW
    gnd_pad = new SmallWirePad;   gnd_pad.contact ~ GND


module McuDebugControls:
    """宽栈道 4.5×4.5 THT 轻触（与尾键同规格）：BOOT / EN / 开机测试（并联 btn_sw↔GND）。"""
    pin BOOT
    pin EN
    pin BUTTON
    pin GND

    sw_boot = new TactileSwitch45
    sw_en = new TactileSwitch45
    sw_pwr = new TactileSwitch45
    sw_boot.a ~ BOOT
    sw_boot.b ~ GND
    sw_en.a ~ EN
    sw_en.b ~ GND
    sw_pwr.a ~ BUTTON
    sw_pwr.b ~ GND


module McuPowerLed:
    """MCU 旁可选 0603 电源指示（可 DNP）。"""
    pin VCC_3V3
    pin GND

    led = new LED_0603
    r_lim = new Resistor
    r_lim.value = "1k"
    led.a ~ VCC_3V3
    led.c ~ r_lim.p1
    r_lim.p2 ~ GND


module BatterySense:
    """可选电芯电压采样。必须接充电总成 B+（bat_cell_p），禁止接 SYS_5V_*。"""
    pin BAT_CELL_P
    pin GND
    pin SENSE

    r_top = new Resistor
    r_bottom = new Resistor
    c_filter = new Capacitor
    r_top.value = "1M"
    r_bottom.value = "1M"
    c_filter.value = "100nF"

    r_top.p1 ~ BAT_CELL_P
    r_top.p2 ~ SENSE
    r_bottom.p1 ~ SENSE
    r_bottom.p2 ~ GND
    c_filter.p1 ~ SENSE
    c_filter.p2 ~ GND



module SmartPaddleRigid:
    mcu = new SGFK_ESP32C6N8_Cutout
    imu = new IM948_Cutout
    power = new PowerLatchAndRegulator
    tail = new TailHarness5P2S
    bringup = new TestPads
    debug_sw = new McuDebugControls
    pwr_led = new McuPowerLed
    battery = new BatterySense

    # Inline LED interface components (atopile 0.2.x module nesting bug workaround)
    led_r_data = new Resistor
    led_c_supply = new Capacitor
    led_r_data.value = "330R"
    led_c_supply.value = "100nF"

    pzt_tr = new PZTDock
    pzt_tl = new PZTDock
    pzt_br = new PZTDock
    pzt_bl = new PZTDock

    signal gnd
    signal sys_5v_in
    signal sys_5v_sw
    signal vcc
    signal en
    signal usb_dp
    signal usb_dn
    signal uart_tx
    signal uart_rx
    signal imu_uart_tx
    signal imu_uart_rx
    signal led_data
    signal led_din
    signal btn_sw
    signal boot_btn
    signal user_btn
    signal pwr_latch
    signal p_gate
    signal imu_key
    signal imu_gpio
    signal bat_cell_p
    signal bat_sense

    signal pzt_tr_signal
    signal pzt_tl_signal
    signal pzt_br_signal
    signal pzt_bl_signal

    # Power：充电总成 5V OUT 为唯一输入；无 USB/电池 OR。
    tail.SYS_5V_IN ~ sys_5v_in
    tail.GND ~ gnd
    power.SYS_5V_IN ~ sys_5v_in
    power.SYS_5V_SW ~ sys_5v_sw
    power.VCC_3V3 ~ vcc
    power.GND ~ gnd
    mcu.VCC_3V3 ~ vcc
    mcu.GND_1 ~ gnd
    mcu.GND_28 ~ gnd

    # IM948：仅 VBUS←SYS_5V_SW；VBAT/VDDIO 悬空（模块内 IO 供电）。
    imu.VBUS ~ sys_5v_sw
    imu.GND_1 ~ gnd
    imu.GND_8 ~ gnd
    imu.GND_16 ~ gnd
    imu.ADIN ~ bat_sense
    imu.RXD ~ imu_uart_tx
    imu.TXD ~ imu_uart_rx
    imu.KEY ~ imu_key
    imu.GPIO ~ imu_gpio
    mcu.GPIO23_IMU_TX ~ imu_uart_tx
    mcu.GPIO22_IMU_RX ~ imu_uart_rx

    # ESP32-C6 control, programming, and user input.
    mcu.EN ~ en
    power.EN ~ en
    mcu.GPIO9_BOOT ~ boot_btn
    mcu.GPIO18_USER_BTN ~ user_btn
    mcu.PWR_LATCH ~ pwr_latch
    power.PWR_LATCH ~ pwr_latch
    power.P_GATE ~ p_gate
    tail.BUTTON ~ btn_sw
    power.BUTTON_RAW ~ btn_sw
    power.BUTTON_GPIO ~ user_btn

    # 宽栈道 BOOT/EN/开机测试键；MCU 旁可选电源灯。
    debug_sw.BOOT ~ boot_btn
    debug_sw.EN ~ en
    debug_sw.BUTTON ~ btn_sw
    debug_sw.GND ~ gnd
    pwr_led.VCC_3V3 ~ vcc
    pwr_led.GND ~ gnd

    # 烧录/调试尾插（与充电仓 Type-C 分离；仓口通常无 D+/D−）。
    tail.USB_DP ~ usb_dp
    tail.USB_DN ~ usb_dn
    tail.UART_TX ~ uart_tx
    tail.UART_RX ~ uart_rx
    mcu.USB_DP ~ usb_dp
    mcu.USB_DN ~ usb_dn
    mcu.UART_TX ~ uart_tx
    mcu.UART_RX ~ uart_rx

    # 状态灯吃开关后 5V。
    tail.LED_PLUS ~ sys_5v_sw
    tail.LED_DIN ~ led_din
    led_c_supply.p1 ~ sys_5v_sw
    led_c_supply.p2 ~ gnd
    led_r_data.p1 ~ led_data
    led_r_data.p2 ~ led_din
    mcu.GPIO8_LED_DATA ~ led_data

    # 低电采样：只接电芯 B+（尾插 BAT_CELL_P），绝不能接 SYS_5V_*。
    tail.BAT_CELL_P ~ bat_cell_p
    battery.BAT_CELL_P ~ bat_cell_p
    battery.GND ~ gnd
    battery.SENSE ~ bat_sense

    bringup.SYS_5V_SW ~ sys_5v_sw
    bringup.VCC_3V3 ~ vcc
    bringup.GND ~ gnd

    # PZT：TL/TR 用对侧 IO2/IO3；BL/BR 仍在拍柄侧 IO6/IO7。
    mcu.GPIO3_PZT_TR ~ pzt_tr_signal
    pzt_tr.MCU_SIGNAL ~ pzt_tr_signal
    pzt_tr.gnd ~ gnd
    pzt_tr.vcc ~ vcc

    mcu.GPIO2_PZT_TL ~ pzt_tl_signal
    pzt_tl.MCU_SIGNAL ~ pzt_tl_signal
    pzt_tl.gnd ~ gnd
    pzt_tl.vcc ~ vcc

    mcu.GPIO7_PZT_BR ~ pzt_br_signal
    pzt_br.MCU_SIGNAL ~ pzt_br_signal
    pzt_br.gnd ~ gnd
    pzt_br.vcc ~ vcc

    mcu.GPIO6_PZT_BL ~ pzt_bl_signal
    pzt_bl.MCU_SIGNAL ~ pzt_bl_signal
    pzt_bl.gnd ~ gnd
    pzt_bl.vcc ~ vcc
