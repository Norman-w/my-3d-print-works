"""SmartPaddle rigid PCB logic.

This file is the intended source of truth for electrical connectivity.
KiCad-side scripts may maintain mechanical reference drawings, edge cuts,
and special generated pads, but nets should be mirrored from here instead of
being invented inside geometry scripts.
"""

from "parts.ato" import Resistor
from "parts.ato" import Capacitor
from "parts.ato" import Diode
from "parts.ato" import BAT54S
from "parts.ato" import PChannelMOSFET_SOT23
from "parts.ato" import NChannelMOSFET_SOT23
from "parts.ato" import TPS62162_3V3
from "parts.ato" import InductorXFL3012_2u2
from "parts.ato" import Capacitor0805
from "parts.ato" import Capacitor1206
from "parts.ato" import MCP4728_MSOP10
from "parts.ato" import TLV1814_TSSOP14
from "parts.ato" import WirePad
from "parts.ato" import SmallWirePad
from "parts.ato" import MolexPicoBlade_53261_5P
from "parts.ato" import LED_0603
from "parts.ato" import TactileSwitch45


component ESP32S3WROOM1_Cutout:
    """ESP32-S3-WROOM-1-N16R8 embedded half-hole interface.

    Truth source: pcb/lib/esp32s3wroom1/pinmap.py. Top/component view,
    antenna -X. GPIO35..37 are reserved by octal PSRAM and remain unused.
    The cutout assembly cannot land underside EP41, so both perimeter GND
    pads must be bonded with short, via-rich ground connections.
    """
    designator_prefix = "J"
    signal GND_1
    signal VCC_3V3
    signal EN
    signal GPIO4_PZT_ADC_BL
    signal GPIO6_PZT_EDGE_BL
    signal GPIO7_PZT_EDGE_BR
    signal GPIO15_PZT_EDGE_TR
    signal GPIO16_PZT_EDGE_TL
    signal GPIO17_I2C_SDA
    signal GPIO18_I2C_SCL
    signal GPIO8_PZT_ADC_BR
    signal USB_DN
    signal USB_DP
    signal GPIO9_BAT_SENSE
    signal GPIO21_LED_DATA
    signal GPIO47_PWR_LATCH
    signal GPIO48_USER_BTN
    signal GPIO0_BOOT
    signal GPIO40_IMU_RX
    signal GPIO41_IMU_TX
    signal UART_RX
    signal UART_TX
    signal GPIO2_PZT_ADC_TR
    signal GPIO1_PZT_ADC_TL
    signal GND_40

    GND_1 ~ pin 1
    VCC_3V3 ~ pin 2
    EN ~ pin 3
    GPIO4_PZT_ADC_BL ~ pin 4
    GPIO6_PZT_EDGE_BL ~ pin 6
    GPIO7_PZT_EDGE_BR ~ pin 7
    GPIO15_PZT_EDGE_TR ~ pin 8
    GPIO16_PZT_EDGE_TL ~ pin 9
    GPIO17_I2C_SDA ~ pin 10
    GPIO18_I2C_SCL ~ pin 11
    GPIO8_PZT_ADC_BR ~ pin 12
    USB_DN ~ pin 13
    USB_DP ~ pin 14
    GPIO9_BAT_SENSE ~ pin 17
    GPIO21_LED_DATA ~ pin 23
    GPIO47_PWR_LATCH ~ pin 24
    GPIO48_USER_BTN ~ pin 25
    GPIO0_BOOT ~ pin 27
    GPIO40_IMU_RX ~ pin 33
    GPIO41_IMU_TX ~ pin 34
    UART_RX ~ pin 36
    UART_TX ~ pin 37
    GPIO2_PZT_ADC_TR ~ pin 38
    GPIO1_PZT_ADC_TL ~ pin 39
    GND_40 ~ pin 40
    footprint = "SmartPaddle:ESP32-S3-WROOM-1_CUTOUT"

component IM948_Cutout:
    designator_prefix = "U"
    signal GND_1
    signal GND_8
    signal VBUS
    signal VBAT_3
    signal VDDIO
    signal ADIN
    signal LED_B
    signal LED_R
    signal GPIO
    signal KEY
    signal RXD
    signal TXD
    signal VBAT_15
    signal GND_16

    GND_1 ~ pin 1
    VBUS ~ pin 2
    VBAT_3 ~ pin 3
    VDDIO ~ pin 4
    ADIN ~ pin 7
    GND_8 ~ pin 8
    LED_B ~ pin 9
    LED_R ~ pin 10
    GPIO ~ pin 11
    KEY ~ pin 12
    RXD ~ pin 13
    TXD ~ pin 14
    VBAT_15 ~ pin 15
    GND_16 ~ pin 16
    footprint = "SmartPaddle:IM948_CUTOUT"

module PZTDock:
    pin SIGNAL_PAD
    pin GND_PAD
    pin CMP_INPUT
    pin CLAMP_GND
    pin CLAMP_VCC

    signal pzt_raw
    signal pzt_mcu
    signal gnd
    signal vcc

    SIGNAL_PAD ~ pzt_raw
    CMP_INPUT ~ pzt_mcu
    GND_PAD ~ gnd
    CLAMP_GND ~ gnd
    CLAMP_VCC ~ vcc

    pzt_signal_pad = new WirePad
    pzt_gnd_pad = new WirePad
    series_resistor = new Resistor
    bleed_resistor = new Resistor
    clamp_diode = new BAT54S
    series_resistor.value = "4.7k"
    bleed_resistor.value = "1M"

    pzt_signal_pad.contact ~ SIGNAL_PAD
    pzt_gnd_pad.contact ~ GND_PAD
    series_resistor.p1 ~ pzt_raw
    series_resistor.p2 ~ CMP_INPUT
    bleed_resistor.p1 ~ pzt_raw
    bleed_resistor.p2 ~ CLAMP_GND
    clamp_diode.signal_node ~ CMP_INPUT
    clamp_diode.low_rail ~ CLAMP_GND
    clamp_diode.high_rail ~ CLAMP_VCC


module PztThresholdFrontend:
    """Four PZT thresholds: MCP4728 DAC + TLV1814 push-pull comparator.

    The ADC peeks are DNP by default. Fitting JP_ADC_* connects the
    comparator input through 1M to a dedicated ADC1 pin; comparator timing
    remains independent of the ADC path.
    """
    pin VCC_3V3
    pin GND
    pin I2C_SDA
    pin I2C_SCL
    pin CMP_IN_TL
    pin CMP_IN_TR
    pin CMP_IN_BL
    pin CMP_IN_BR
    pin EDGE_TL
    pin EDGE_TR
    pin EDGE_BL
    pin EDGE_BR
    pin ADC_TL
    pin ADC_TR
    pin ADC_BL
    pin ADC_BR

    signal vref_tl
    signal vref_tr
    signal vref_bl
    signal vref_br
    signal adc_iso_tl
    signal adc_iso_tr
    signal adc_iso_bl
    signal adc_iso_br

    dac = new MCP4728_MSOP10
    comparator = new TLV1814_TSSOP14
    r_sda_pullup = new Resistor
    r_scl_pullup = new Resistor
    c_dac = new Capacitor
    c_comparator = new Capacitor
    r_adc_tl = new Resistor
    r_adc_tr = new Resistor
    r_adc_bl = new Resistor
    r_adc_br = new Resistor
    jp_adc_tl = new Resistor
    jp_adc_tr = new Resistor
    jp_adc_bl = new Resistor
    jp_adc_br = new Resistor

    r_sda_pullup.value = "4.7k"
    r_scl_pullup.value = "4.7k"
    c_dac.value = "100nF"
    c_comparator.value = "100nF"
    r_adc_tl.value = "1M"
    r_adc_tr.value = "1M"
    r_adc_bl.value = "1M"
    r_adc_br.value = "1M"
    jp_adc_tl.value = "0R DNP"
    jp_adc_tr.value = "0R DNP"
    jp_adc_bl.value = "0R DNP"
    jp_adc_br.value = "0R DNP"

    # TL/TR intentionally use channels 2/1 respectively.  This keeps the
    # left/right CMP_IN traces from crossing at TLV1814 pins 5 and 7.
    dac.vout_a ~ vref_tr
    dac.vout_b ~ vref_tl
    dac.vout_c ~ vref_bl
    dac.vout_d ~ vref_br
    dac.vss ~ GND
    dac.ldac_n ~ GND
    dac.scl ~ I2C_SCL
    dac.sda ~ I2C_SDA
    dac.vdd ~ VCC_3V3

    comparator.vcc ~ VCC_3V3
    comparator.gnd ~ GND
    comparator.in_1_n ~ vref_tr
    comparator.in_1_p ~ CMP_IN_TR
    comparator.out_1 ~ EDGE_TR
    comparator.in_2_n ~ vref_tl
    comparator.in_2_p ~ CMP_IN_TL
    comparator.out_2 ~ EDGE_TL
    comparator.in_3_n ~ vref_bl
    comparator.in_3_p ~ CMP_IN_BL
    comparator.out_3 ~ EDGE_BL
    comparator.in_4_n ~ vref_br
    comparator.in_4_p ~ CMP_IN_BR
    comparator.out_4 ~ EDGE_BR

    r_sda_pullup.p1 ~ VCC_3V3
    r_sda_pullup.p2 ~ I2C_SDA
    r_scl_pullup.p1 ~ VCC_3V3
    r_scl_pullup.p2 ~ I2C_SCL
    c_dac.p1 ~ VCC_3V3
    c_dac.p2 ~ GND
    c_comparator.p1 ~ VCC_3V3
    c_comparator.p2 ~ GND

    r_adc_tl.p1 ~ CMP_IN_TL
    r_adc_tl.p2 ~ adc_iso_tl
    jp_adc_tl.p1 ~ adc_iso_tl
    jp_adc_tl.p2 ~ ADC_TL
    r_adc_tr.p1 ~ CMP_IN_TR
    r_adc_tr.p2 ~ adc_iso_tr
    jp_adc_tr.p1 ~ adc_iso_tr
    jp_adc_tr.p2 ~ ADC_TR
    r_adc_bl.p1 ~ CMP_IN_BL
    r_adc_bl.p2 ~ adc_iso_bl
    jp_adc_bl.p1 ~ adc_iso_bl
    jp_adc_bl.p2 ~ ADC_BL
    r_adc_br.p1 ~ CMP_IN_BR
    r_adc_br.p2 ~ adc_iso_br
    jp_adc_br.p1 ~ adc_iso_br
    jp_adc_br.p2 ~ ADC_BR



module TailHarness5P2S:
    """柄尾 MX1.25 卧贴：正反各 1×5P（Molex PicoBlade 53261-0571）。

    正面 F @ rot0；背面 B @ Flip+rot180（开口朝外），板坐标 X 上：
    F.p1(5V) 对 B.p5(GND)，F.p4(D+) 对 B.p2(D-)，F.p5(TX) 对 B.p1(RX)。
    SYS_5V_IN=充电总成 5V OUT；BAT_CELL_P=可选电芯 B+ 采样（非 5V）。
    烧录走 USB D+/D−；充电仓 Type-C 通常无 D+/D−。
    引脚表 / 端面图：docs/1.25x10p/README.md 、output/assembly/smartpaddle_tail_wiring.html
    """
    pin SYS_5V_IN
    pin GND
    pin LED_PLUS
    pin LED_DIN
    pin BUTTON
    pin BAT_CELL_P
    pin USB_DP
    pin USB_DN
    pin UART_TX
    pin UART_RX

    conn_f = new MolexPicoBlade_53261_5P
    conn_f.p1 ~ SYS_5V_IN
    conn_f.p2 ~ LED_PLUS
    conn_f.p3 ~ BUTTON
    conn_f.p4 ~ USB_DP
    conn_f.p5 ~ UART_TX

    conn_b = new MolexPicoBlade_53261_5P
    conn_b.p1 ~ UART_RX
    conn_b.p2 ~ USB_DN
    conn_b.p3 ~ BAT_CELL_P
    conn_b.p4 ~ LED_DIN
    conn_b.p5 ~ GND



module PowerLatchAndRegulator:
    """软开关 + 3.3 V 同步降压 + 隔离按键读回。

    唯一系统输入：尾板受限流 5 V → SYS_5V_IN → PMOS → SYS_5V_SW
    → TPS62162。按键只通过二极管拉低 P_GATE；MCU 读键由独立 NMOS
    反相隔离，GPIO 的 3.3 V 上拉不再钳住 PMOS 门极。
    """
    pin SYS_5V_IN
    pin SYS_5V_SW
    pin VCC_3V3
    pin GND
    pin EN
    pin PWR_LATCH
    pin BUTTON_RAW
    pin BUTTON_GPIO
    pin P_GATE

    q_power = new PChannelMOSFET_SOT23
    q_latch = new NChannelMOSFET_SOT23
    q_button_sense = new NChannelMOSFET_SOT23
    r_gate = new Resistor
    r_button_series = new Resistor
    r_button_pullup = new Resistor
    r_button_gpio_pullup = new Resistor
    r_latch_pd = new Resistor
    r_en_pullup = new Resistor
    # 开机隔离：阳极→P_GATE，阴极→BUTTON_RAW
    d_btn_start = new Diode
    # 保留实例名 ldo 以维持既有 atopile_address；器件已改为同步 Buck。
    ldo = new TPS62162_3V3
    l_buck = new InductorXFL3012_2u2
    c_in = new Capacitor0805
    c_out = new Capacitor1206
    r_gate.value = "100k"
    r_button_series.value = "1k"
    r_button_pullup.value = "100k"
    r_button_gpio_pullup.value = "100k"
    r_latch_pd.value = "100k"
    r_en_pullup.value = "10k"
    d_btn_start.value = "1N4148W"
    c_in.value = "10uF 10V X5R/X7R"
    c_out.value = "22uF 6.3V X5R/X7R"

    signal buck_sw
    signal button_sense_gate

    q_power.gate ~ P_GATE
    q_power.source ~ SYS_5V_IN
    q_power.drain ~ SYS_5V_SW

    q_latch.gate ~ PWR_LATCH
    q_latch.source ~ GND
    q_latch.drain ~ P_GATE

    r_gate.p1 ~ P_GATE
    r_gate.p2 ~ SYS_5V_IN

    d_btn_start.anode ~ P_GATE
    d_btn_start.cathode ~ BUTTON_RAW

    # BUTTON_RAW 在松键时由 5 V 域拉高；1 k 仅限制瞬态/ESD 电流。
    # NMOS 将其转换为完全隔离的 3.3 V GPIO：按下=GPIO 高，松开=低。
    r_button_pullup.p1 ~ BUTTON_RAW
    r_button_pullup.p2 ~ SYS_5V_IN
    r_button_series.p1 ~ BUTTON_RAW
    r_button_series.p2 ~ button_sense_gate
    q_button_sense.gate ~ button_sense_gate
    q_button_sense.source ~ GND
    q_button_sense.drain ~ BUTTON_GPIO
    r_button_gpio_pullup.p1 ~ BUTTON_GPIO
    r_button_gpio_pullup.p2 ~ VCC_3V3

    r_latch_pd.p1 ~ PWR_LATCH
    r_latch_pd.p2 ~ GND
    r_en_pullup.p1 ~ EN
    r_en_pullup.p2 ~ VCC_3V3

    # 开关后的 5 V 经 TPS62162 固定 3.3 V Buck。FB 按固定版本要求接
    # AGND；PG 不用时保持 NC；VOS 必须 Kelvin 接输出电容正端。
    ldo.VIN ~ SYS_5V_SW
    ldo.EN ~ SYS_5V_SW
    ldo.PGND ~ GND
    ldo.AGND ~ GND
    ldo.FB ~ GND
    ldo.EPAD ~ GND
    ldo.SW ~ buck_sw
    ldo.VOS ~ VCC_3V3
    l_buck.p1 ~ buck_sw
    l_buck.p2 ~ VCC_3V3

    c_in.p1 ~ SYS_5V_SW
    c_in.p2 ~ GND
    c_out.p1 ~ VCC_3V3
    c_out.p2 ~ GND



module LEDInterface:
    pin LED_SUPPLY
    pin MCU_DATA
    pin LED_DIN
    pin GND

    r_data = new Resistor
    c_supply = new Capacitor
    r_data.value = "330R"
    c_supply.value = "100nF"

    r_data.p1 ~ MCU_DATA
    r_data.p2 ~ LED_DIN
    c_supply.p1 ~ LED_SUPPLY
    c_supply.p2 ~ GND



module TestPads:
    """Bringup 大陆测试焊盘：TP_3V3 / TP_SYS_5V_SW。BOOT/EN/开机用宽栈道轻触。"""
    pin VCC_3V3
    pin SYS_5V_SW

    vcc_pad = new SmallWirePad;   vcc_pad.contact ~ VCC_3V3
    sys5_pad = new SmallWirePad;  sys5_pad.contact ~ SYS_5V_SW


module McuDebugControls:
    """宽栈道 4.5×4.5 THT 轻触（与尾键同规格）：BOOT / EN / 开机测试（并联 btn_sw↔GND）。"""
    pin BOOT
    pin EN
    pin BUTTON
    pin GND

    sw_boot = new TactileSwitch45
    sw_en = new TactileSwitch45
    sw_pwr = new TactileSwitch45
    sw_boot.a ~ BOOT
    sw_boot.b ~ GND
    sw_en.a ~ EN
    sw_en.b ~ GND
    sw_pwr.a ~ BUTTON
    sw_pwr.b ~ GND


module McuPowerLed:
    """MCU 旁可选 0603 电源指示（可 DNP）。"""
    pin VCC_3V3
    pin GND

    led = new LED_0603
    r_lim = new Resistor
    r_lim.value = "1k"
    led.a ~ VCC_3V3
    led.c ~ r_lim.p1
    r_lim.p2 ~ GND


module BatterySense:
    """可选电芯电压采样。必须接充电总成 B+（bat_cell_p），禁止接 SYS_5V_*。"""
    pin BAT_CELL_P
    pin GND
    pin SENSE

    r_top = new Resistor
    r_bottom = new Resistor
    c_filter = new Capacitor
    r_top.value = "1M"
    r_bottom.value = "1M"
    c_filter.value = "100nF"

    r_top.p1 ~ BAT_CELL_P
    r_top.p2 ~ SENSE
    r_bottom.p1 ~ SENSE
    r_bottom.p2 ~ GND
    c_filter.p1 ~ SENSE
    c_filter.p2 ~ GND



module SmartPaddleRigid:
    mcu = new ESP32S3WROOM1_Cutout
    imu = new IM948_Cutout
    power = new PowerLatchAndRegulator
    tail = new TailHarness5P2S
    bringup = new TestPads
    debug_sw = new McuDebugControls
    pwr_led = new McuPowerLed
    battery = new BatterySense
    pzt_frontend = new PztThresholdFrontend

    # Inline LED and MCU bypass parts keep stable top-level addresses.
    led_r_data = new Resistor
    usb_r_dp = new Resistor
    usb_r_dn = new Resistor
    led_c_supply = new Capacitor
    mcu_c_bulk = new Capacitor
    mcu_c_dec = new Capacitor
    en_c_delay = new Capacitor
    led_r_data.value = "330R"
    usb_r_dp.value = "22R"
    usb_r_dn.value = "22R"
    led_c_supply.value = "100nF"
    mcu_c_bulk.value = "10uF 6.3V X5R/X7R"
    mcu_c_dec.value = "100nF 10V X7R"
    en_c_delay.value = "1uF 10V X5R/X7R"

    pzt_tr = new PZTDock
    pzt_tl = new PZTDock
    pzt_br = new PZTDock
    pzt_bl = new PZTDock

    signal gnd
    signal sys_5v_in
    signal sys_5v_sw
    signal vcc
    signal en
    signal usb_dp
    signal usb_dn
    signal usb_dp_conn
    signal usb_dn_conn
    signal uart_tx
    signal uart_rx
    signal imu_uart_tx
    signal imu_uart_rx
    signal i2c_sda
    signal i2c_scl
    signal led_data
    signal led_din
    signal btn_sw
    signal boot_btn
    signal user_btn
    signal pwr_latch
    signal p_gate
    signal imu_key
    signal imu_gpio
    signal bat_cell_p
    signal bat_sense

    signal pzt_cmp_in_tr
    signal pzt_cmp_in_tl
    signal pzt_cmp_in_br
    signal pzt_cmp_in_bl
    signal pzt_edge_tr
    signal pzt_edge_tl
    signal pzt_edge_br
    signal pzt_edge_bl
    signal pzt_adc_tr
    signal pzt_adc_tl
    signal pzt_adc_br
    signal pzt_adc_bl

    # Power: charging assembly 5V OUT is the only system input.
    tail.SYS_5V_IN ~ sys_5v_in
    tail.GND ~ gnd
    power.SYS_5V_IN ~ sys_5v_in
    power.SYS_5V_SW ~ sys_5v_sw
    power.VCC_3V3 ~ vcc
    power.GND ~ gnd
    mcu.VCC_3V3 ~ vcc
    mcu.GND_1 ~ gnd
    mcu.GND_40 ~ gnd
    mcu_c_bulk.p1 ~ vcc
    mcu_c_bulk.p2 ~ gnd
    mcu_c_dec.p1 ~ vcc
    mcu_c_dec.p2 ~ gnd

    # IM948 remains on switched 5V and UART1.
    imu.VBUS ~ sys_5v_sw
    imu.GND_1 ~ gnd
    imu.GND_8 ~ gnd
    imu.GND_16 ~ gnd
    imu.ADIN ~ bat_sense
    imu.RXD ~ imu_uart_tx
    imu.TXD ~ imu_uart_rx
    imu.KEY ~ imu_key
    imu.GPIO ~ imu_gpio
    mcu.GPIO41_IMU_TX ~ imu_uart_tx
    mcu.GPIO40_IMU_RX ~ imu_uart_rx

    # ESP32-S3 control, programming and user input.
    mcu.EN ~ en
    power.EN ~ en
    en_c_delay.p1 ~ en
    en_c_delay.p2 ~ gnd
    mcu.GPIO0_BOOT ~ boot_btn
    mcu.GPIO48_USER_BTN ~ user_btn
    mcu.GPIO47_PWR_LATCH ~ pwr_latch
    power.PWR_LATCH ~ pwr_latch
    power.P_GATE ~ p_gate
    tail.BUTTON ~ btn_sw
    power.BUTTON_RAW ~ btn_sw
    power.BUTTON_GPIO ~ user_btn

    debug_sw.BOOT ~ boot_btn
    debug_sw.EN ~ en
    debug_sw.BUTTON ~ btn_sw
    debug_sw.GND ~ gnd
    pwr_led.VCC_3V3 ~ vcc
    pwr_led.GND ~ gnd

    # Native USB and UART0 are exposed at the paired tail pins.
    tail.USB_DP ~ usb_dp_conn
    tail.USB_DN ~ usb_dn_conn
    usb_r_dp.p1 ~ usb_dp_conn
    usb_r_dp.p2 ~ usb_dp
    usb_r_dn.p1 ~ usb_dn_conn
    usb_r_dn.p2 ~ usb_dn
    tail.UART_TX ~ uart_tx
    tail.UART_RX ~ uart_rx
    mcu.USB_DP ~ usb_dp
    mcu.USB_DN ~ usb_dn
    mcu.UART_TX ~ uart_tx
    mcu.UART_RX ~ uart_rx

    # Tail-local LED interface: supply/data components are placed near MX1.25.
    tail.LED_PLUS ~ sys_5v_sw
    tail.LED_DIN ~ led_din
    led_c_supply.p1 ~ sys_5v_sw
    led_c_supply.p2 ~ gnd
    led_r_data.p1 ~ led_data
    led_r_data.p2 ~ led_din
    mcu.GPIO21_LED_DATA ~ led_data

    # Tail-local battery divider; S3 GPIO9 and IM948 ADIN can both observe it.
    tail.BAT_CELL_P ~ bat_cell_p
    battery.BAT_CELL_P ~ bat_cell_p
    battery.GND ~ gnd
    battery.SENSE ~ bat_sense
    mcu.GPIO9_BAT_SENSE ~ bat_sense

    bringup.SYS_5V_SW ~ sys_5v_sw
    bringup.VCC_3V3 ~ vcc

    # Dock clamps feed the comparator, never the MCU edge inputs directly.
    pzt_tr.CMP_INPUT ~ pzt_cmp_in_tr
    pzt_tr.gnd ~ gnd
    pzt_tr.vcc ~ vcc
    pzt_tl.CMP_INPUT ~ pzt_cmp_in_tl
    pzt_tl.gnd ~ gnd
    pzt_tl.vcc ~ vcc
    pzt_br.CMP_INPUT ~ pzt_cmp_in_br
    pzt_br.gnd ~ gnd
    pzt_br.vcc ~ vcc
    pzt_bl.CMP_INPUT ~ pzt_cmp_in_bl
    pzt_bl.gnd ~ gnd
    pzt_bl.vcc ~ vcc

    pzt_frontend.VCC_3V3 ~ vcc
    pzt_frontend.GND ~ gnd
    pzt_frontend.I2C_SDA ~ i2c_sda
