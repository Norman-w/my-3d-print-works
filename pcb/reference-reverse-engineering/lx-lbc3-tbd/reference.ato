"""Mechanical-only reference definitions for the photographed LX-LBC3 board.

REFERENCE REVERSE ENGINEERING / TBD.  No signal declarations are connected on
purpose.  Importing these components must not be interpreted as an electrical
claim about the sample board.
"""


component USB_C_6P_PowerOnly_TBD:
    designator_prefix = "J"
    value = "USB-C 6P POWER-ONLY TBD; NO USB2 DATA"
    pin p1_tbd
    pin p2_tbd
    pin p3_tbd
    pin p4_tbd
    pin p5_tbd
    pin p6_tbd
    p1_tbd ~ pin 1
    p2_tbd ~ pin 2
    p3_tbd ~ pin 3
    p4_tbd ~ pin 4
    p5_tbd ~ pin 5
    p6_tbd ~ pin 6
    footprint = "LX_LBC3_Reference:USB_C_6P_POWER_ONLY_TBD"


component PMIC_SOT23_6_TBD:
    """Candidate class only: HT4927U-like integrated charge/boost SoC.

    Pin functions are intentionally unnamed until U1 marking and continuity
    measurements are available.
    """
    designator_prefix = "U"
    value = "PMIC_TBD; HT4927U_CANDIDATE_MEDIUM_HIGH"
    pin p1_tbd
    pin p2_tbd
    pin p3_tbd
    pin p4_tbd
    pin p5_tbd
    pin p6_tbd
    p1_tbd ~ pin 1
    p2_tbd ~ pin 2
    p3_tbd ~ pin 3
    p4_tbd ~ pin 4
    p5_tbd ~ pin 5
    p6_tbd ~ pin 6
    footprint = "Package_TO_SOT_SMD:SOT-23-6"


component WoundInductor4mm_TBD:
    designator_prefix = "L"
    value = "L_TBD; 2.2uH-4.7uH CANDIDATE ONLY"
    pin p1_tbd
    pin p2_tbd
    p1_tbd ~ pin 1
    p2_tbd ~ pin 2
    footprint = "LX_LBC3_Reference:Inductor_Wound_4x4_TBD"


component WirePad_TBD:
    designator_prefix = "J"
    value = "PAD_TBD"
    pin contact_tbd
    contact_tbd ~ pin 1
    footprint = "LX_LBC3_Reference:WirePad_2p4mm_TBD"


module LXLBC3ReferenceTBD:
    """Unconnected mechanical inventory; not a schematic."""
    type_c = new USB_C_6P_PowerOnly_TBD
    pmic = new PMIC_SOT23_6_TBD
    boost_inductor = new WoundInductor4mm_TBD
    pad_5v_minus = new WirePad_TBD
    pad_5v_plus = new WirePad_TBD
    pad_bat_minus = new WirePad_TBD
    pad_bat_plus = new WirePad_TBD

    pad_5v_minus.value = "5V- PHOTO LABEL; NETWORK TBD"
    pad_5v_plus.value = "5V+ PHOTO LABEL; NETWORK TBD"
    pad_bat_minus.value = "B- PHOTO LABEL; NETWORK TBD"
    pad_bat_plus.value = "B+ PHOTO LABEL; NETWORK TBD"
