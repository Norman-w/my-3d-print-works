"""Generic and project-specific physical parts for the rigid PCB."""


component Resistor:
    designator_prefix = "R"
    value = "unknown"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "Resistor_SMD:R_0603_1608Metric"


component Capacitor:
    designator_prefix = "C"
    value = "unknown"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "Capacitor_SMD:C_0603_1608Metric"


component Capacitor0805:
    """Power-path ceramic capacitor, 0805."""
    designator_prefix = "C"
    value = "unknown"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "Capacitor_SMD:C_0805_2012Metric"


component Capacitor1206:
    """Power-path ceramic capacitor, 1206, for DC-bias margin."""
    designator_prefix = "C"
    value = "unknown"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "Capacitor_SMD:C_1206_3216Metric"


component Diode:
    """小信号二极管（开机隔离等）。默认 1N4148W / BAS16，SOD-323。

    用官方 HandSoldering 加大焊盘，便于手焊（V3 装配反馈）。
    """
    designator_prefix = "D"
    value = "1N4148W"
    signal anode
    signal cathode
    anode ~ pin 2
    cathode ~ pin 1
    footprint = "SmartPaddle:D_SOD-323_HandSoldering"


component Schottky1A_SOD123:
    """主电源 OR 用 1A 肖特基（SS14 / MBR130 等），勿用 BAT54 串整机供电。"""
    designator_prefix = "D"
    value = "SS14"
    signal anode
    signal cathode
    anode ~ pin 2
    cathode ~ pin 1
    footprint = "Diode_SMD:D_SOD-123"


component BAT54S:
    designator_prefix = "D"
    value = "BAT54S"
    signal low_rail
    signal high_rail
    signal signal_node
    # BAT54S dual-series clamp: pin 1 = low-side anode, pin 3 = common signal,
    # pin 2 = high-side cathode.  Do not swap pins 2/3 for rail clamping.
    low_rail ~ pin 1
    high_rail ~ pin 2
    signal_node ~ pin 3
    footprint = "Package_TO_SOT_SMD:SOT-23"


component PChannelMOSFET_SOT23:
    """AOS AO3401A, -30 V P-channel load switch.

    The exact part number is intentional: its SOT-23 pinout is
    1=G, 2=S, 3=D, matching the C4 routed board.  Do not substitute a
    differently pinned generic P-MOSFET without reviewing the footprint.
    """
    designator_prefix = "Q"
    value = "AO3401A"
    signal gate
    signal source
    signal drain
    gate ~ pin 1
    source ~ pin 2
    drain ~ pin 3
    footprint = "Package_TO_SOT_SMD:SOT-23"


component NChannelMOSFET_SOT23:
    """AOS AO3400A, 30 V logic-level N-channel latch transistor.

    The exact part number is intentional: its SOT-23 pinout is
    1=G, 2=S, 3=D, matching the C4 routed board.
    """
    designator_prefix = "Q"
    value = "AO3400A"
    signal gate
    signal source
    signal drain
    gate ~ pin 1
    source ~ pin 2
    drain ~ pin 3
    footprint = "Package_TO_SOT_SMD:SOT-23"


component AP2112K_3V3:
    designator_prefix = "U"
    value = "AP2112K-3.3"
    signal vin
    signal gnd
    signal en
    signal nc
    signal vout
    vin ~ pin 1
    gnd ~ pin 2
    en ~ pin 3
    nc ~ pin 4
    vout ~ pin 5
    footprint = "Package_TO_SOT_SMD:SOT-23-5"


component TPS62162_3V3:
    """TI TPS62162 fixed 3.3 V / 1 A synchronous buck, DSG WSON-8.

    Top-view pin map from TI SLVSAM2E: 1=PGND, 2=VIN, 3=EN,
    4=AGND, 5=FB, 6=VOS, 7=SW, 8=PG, EP=AGND.  For the fixed
    3.3 V version FB is tied to AGND; PG may be left open.
    """
    designator_prefix = "U"
    value = "TPS62162DSGR"
    signal PGND
    signal VIN
    signal EN
    signal AGND
    signal FB
    signal VOS
    signal SW
    signal PG
    signal EPAD
    PGND ~ pin 1
    VIN ~ pin 2
    EN ~ pin 3
    AGND ~ pin 4
    FB ~ pin 5
    VOS ~ pin 6
    SW ~ pin 7
    PG ~ pin 8
    EPAD ~ pin 9
    footprint = "Package_SON:Texas_DSG0008A_WSON-8-1EP_2x2mm_P0.5mm_EP0.9x1.6mm"


component InductorXFL3012_2u2:
    """Coilcraft XFL3012-222MEC, 2.2 uH ±20%, 3.0×3.0×1.3 mm.

    DCR 0.097 ohm max; Isat 1.0/1.3/1.6 A at 10/20/30% drop;
    Irms 1.9 A at 40°C rise.  Source is archived under
    docs/power-architecture-rework/sources/Coilcraft-XFL3012-Doc747.pdf.
    """
    designator_prefix = "L"
    value = "XFL3012-222MEC 2.2uH"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "SmartPaddle:L_Coilcraft_XFL3012"


component MCP4728_MSOP10:
    """Microchip MCP4728 quad 12-bit I2C DAC, 10-lead MSOP."""
    designator_prefix = "U"
    value = "MCP4728-E/UN"
    signal vout_a
    signal vout_b
    signal vout_c
    signal vout_d
    signal vss
    signal ldac_n
    signal scl
    signal sda
    signal vdd
    signal rdy_n
    vout_a ~ pin 1
    vout_b ~ pin 2
    vout_c ~ pin 3
    vout_d ~ pin 4
    vss ~ pin 5
    ldac_n ~ pin 6
    scl ~ pin 7
    sda ~ pin 8
    vdd ~ pin 9
    rdy_n ~ pin 10
    footprint = "Package_SO:MSOP-10_3x3mm_P0.5mm"


component TLV1814_TSSOP14:
    """TI TLV1814 quad rail-to-rail comparator with push-pull outputs.

    TLV1804 in the early C4 notes was a typo; TLV1814 is the released
    four-channel push-pull member. Pin numbers follow TI's PW package.
    """
    designator_prefix = "U"
    value = "TLV1814PWR"
    signal out_2
    signal out_1
    signal vcc
    signal in_1_n
    signal in_1_p
    signal in_2_n
    signal in_2_p
    signal in_3_n
    signal in_3_p
    signal in_4_n
    signal in_4_p
    signal gnd
    signal out_4
    signal out_3
    out_2 ~ pin 1
    out_1 ~ pin 2
    vcc ~ pin 3
    in_1_n ~ pin 4
    in_1_p ~ pin 5
    in_2_n ~ pin 6
    in_2_p ~ pin 7
    in_3_n ~ pin 8
    in_3_p ~ pin 9
    in_4_n ~ pin 10
    in_4_p ~ pin 11
    gnd ~ pin 12
    out_4 ~ pin 13
    out_3 ~ pin 14
    footprint = "Package_SO:TSSOP-14_4.4x5mm_P0.65mm"


component WirePad:
    """PZT 引线焊盘；板边不放丝印，避免成品丝印被外形裁切。"""
    designator_prefix = "TP"
    signal contact
    contact ~ pin 1
    footprint = "SmartPaddle:PZT_WirePad_THT_D2.5mm_Drill1.2mm"


component SmallWirePad:
    """大陆 / bringup 小测试点（含 TP_GND）；官方 TestPoint THT 校本化。"""
    designator_prefix = "TP"
    signal contact
    contact ~ pin 1
    footprint = "SmartPaddle:TestPoint_THTPad_D2.0mm_Drill1.0mm"


component EdgeFingerPad:
    """金手指焊盘（双面），pad "F" 在 F.Cu，pad "B" 在 B.Cu（旧尾插；新板改用 MX1.25 卧贴）。"""
    designator_prefix = "J"
    value = "GoldFinger"
    signal front
    signal back
    front ~ pin "F"
    back ~ pin "B"
    footprint = "SmartPaddle:EdgeFingerPad_P1.27mm_Dual"


component MolexPicoBlade_53261_5P:
    """MX1.25 / Molex PicoBlade 53261-0571：1.25 mm × 5P 卧贴 + 侧耳。

    柄尾正反各一颗（F/B）；封装/3D 校本化，见 docs/1.25x10p/README.md
    """
    designator_prefix = "J"
    value = "MX1.25-5P"
    signal p1
    signal p2
    signal p3
    signal p4
    signal p5
    p1 ~ pin 1
    p2 ~ pin 2
    p3 ~ pin 3
    p4 ~ pin 4
    p5 ~ pin 5
    footprint = "SmartPaddle:Molex_PicoBlade_53261-0571_1x05-1MP_P1.25mm_Horizontal"


component LED_0603:
    designator_prefix = "LED"
    value = "LED"
    signal a
    signal c
    a ~ pin 1
    c ~ pin 2
    footprint = "SmartPaddle:LED_0603"


component Omron_B3U_1000P_Debug:
    """Omron B3U-1000P 超小型顶按 SPST-NO 贴片调试键，默认 DNP。

    三只主板键只在裸板调试时选焊；成品不焊、壳体不开操作孔。尺寸与
    焊盘依据项目归档的 Omron A162-E1-07 数据表以及 KiCad 9 stock
    `Button_Switch_SMD:SW_SPST_B3U-1000P`，与尾板日常用户键同一料号。
    """
    designator_prefix = "SW"
    value = "B3U-1000P DNP"
    signal a
    signal b
    a ~ pin 1
    b ~ pin 2
    footprint = "Button_Switch_SMD:SW_SPST_B3U-1000P"
