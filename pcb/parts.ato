"""Generic and project-specific physical parts for the rigid PCB."""


component Resistor:
    designator_prefix = "R"
    value = "unknown"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "Resistor_SMD:R_0603_1608Metric"


component Capacitor:
    designator_prefix = "C"
    value = "unknown"
    signal p1
    signal p2
    p1 ~ pin 1
    p2 ~ pin 2
    footprint = "Capacitor_SMD:C_0603_1608Metric"


component Diode:
    """小信号二极管（开机隔离等）。默认 1N4148W / BAS16，SOD-323。

    用官方 HandSoldering 加大焊盘，便于手焊（V3 装配反馈）。
    """
    designator_prefix = "D"
    value = "1N4148W"
    signal anode
    signal cathode
    anode ~ pin 2
    cathode ~ pin 1
    footprint = "SmartPaddle:D_SOD-323_HandSoldering"


component Schottky1A_SOD123:
    """主电源 OR 用 1A 肖特基（SS14 / MBR130 等），勿用 BAT54 串整机供电。"""
    designator_prefix = "D"
    value = "SS14"
    signal anode
    signal cathode
    anode ~ pin 2
    cathode ~ pin 1
    footprint = "Diode_SMD:D_SOD-123"


component BAT54S:
    designator_prefix = "D"
    value = "BAT54S"
    signal low_rail
    signal high_rail
    signal signal_node
    # BAT54S dual-series clamp: pin 1 = low-side anode, pin 3 = common signal,
    # pin 2 = high-side cathode.  Do not swap pins 2/3 for rail clamping.
    low_rail ~ pin 1
    high_rail ~ pin 2
    signal_node ~ pin 3
    footprint = "Package_TO_SOT_SMD:SOT-23"


component PChannelMOSFET_SOT23:
    designator_prefix = "Q"
    value = "P-MOSFET"
    signal gate
    signal source
    signal drain
    gate ~ pin 1
    source ~ pin 2
    drain ~ pin 3
    footprint = "Package_TO_SOT_SMD:SOT-23"


component NChannelMOSFET_SOT23:
    designator_prefix = "Q"
    value = "N-MOSFET"
    signal gate
    signal source
    signal drain
    gate ~ pin 1
    source ~ pin 2
    drain ~ pin 3
    footprint = "Package_TO_SOT_SMD:SOT-23"


component AP2112K_3V3:
    designator_prefix = "U"
    value = "AP2112K-3.3"
    signal vin
    signal gnd
    signal en
    signal nc
    signal vout
    vin ~ pin 1
    gnd ~ pin 2
    en ~ pin 3
    nc ~ pin 4
    vout ~ pin 5
    footprint = "Package_TO_SOT_SMD:SOT-23-5"


component WirePad:
    designator_prefix = "TP"
    signal contact
    contact ~ pin 1
    footprint = "TestPoint:TestPoint_THTPad_D2.5mm_Drill1.2mm"


component SmallWirePad:
    """大陆 / bringup 小测试点（含 TP_GND）；官方 TestPoint THT 校本化。"""
    designator_prefix = "TP"
    signal contact
    contact ~ pin 1
    footprint = "SmartPaddle:TestPoint_THTPad_D2.0mm_Drill1.0mm"


component EdgeFingerPad:
    """金手指焊盘（双面），pad "F" 在 F.Cu，pad "B" 在 B.Cu，独立网络，适合 PCB 尾插。"""
    designator_prefix = "J"
    value = "GoldFinger"
    signal front
    signal back
    front ~ pin "F"
    back ~ pin "B"
    footprint = "SmartPaddle:EdgeFingerPad_P1.27mm_Dual"


component LED_0603:
    designator_prefix = "LED"
    value = "LED"
    signal a
    signal c
    a ~ pin 1
    c ~ pin 2
    footprint = "SmartPaddle:LED_0603"


component TactileSwitch45:
    """4.5×4.5 mm SPST 轻触（与尾部电源键同规格；V3 测试键为 THT 插脚）。

    焊盘几何：pcb/lib/tactile_45/params.py → generate_sw_spst_45_tht_mod.py
    """
    designator_prefix = "SW"
    value = "4.5x4.5"
    signal a
    signal b
    a ~ pin 1
    b ~ pin 2
    footprint = "SmartPaddle:SW_SPST_4.5x4.5"
