.DS_Store
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
/result.json

# Preserve engineering source and textual review evidence at their original paths.
# Generated meshes, slicer packages, media and logs stay local.
/output/**
!/output/**/
!/output/**/*.py
!/output/**/*.scad
!/output/**/*.md
!/output/**/*.json
!/output/**/*.csv
/output/**/__pycache__/

# Raw orders, local service state and deployed preview assets are never tracked.
/output/procurement/
/output/preview-service/
/output/revision-review/
/output/preview-history/
/output/electric-feeder/publication.json
/output/optical-home-candidate/slices/**/*.json

# Per-orientation slicer metadata is reproducible cache, not review evidence.
# Keep the curated top-level review and slice-review JSON files above these paths.
/output/**/slices/**/*.json
/output/**/slice-*/**/*.json
/output/**/orientation-screen/**/*.json
/output/**/slice-screen/**/*.json
/output/**/explore/
