.DS_Store
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
/result.json

# Preserve engineering source and textual review evidence at their original paths.
# Generated meshes, slicer packages, media and logs stay local.
/output/**
!/output/**/
!/output/**/*.py
!/output/**/*.scad
!/output/**/*.md
!/output/**/*.json
!/output/**/*.csv
/output/**/__pycache__/

# Raw orders, local service state and deployed preview assets are never tracked.
/output/procurement/
/output/preview-service/
/output/revision-review/
/output/preview-history/
/output/electric-feeder/publication.json
/output/optical-home-candidate/slices/**/*.json

# Per-orientation slicer metadata is reproducible cache, not review evidence.
# Keep the curated top-level review and slice-review JSON files above these paths.
/output/**/slices/**/*.json
/output/**/slice-*/**/*.json
/output/**/orientation-screen/**/*.json
/output/**/slice-screen/**/*.json
/output/**/explore/

# Frozen v4 first-article delivery: keep only the final clean model, native
# print packages, reviewed images and compatibility witnesses as binaries.
!/output/fan-tee-direct-print-v4-20261007/stl/fan-tee-v4-connector-clean.stl
!/output/fan-tee-direct-print-v4-20261007/print/slice/fan-tee-v4-native-project.3mf
!/output/fan-tee-direct-print-v4-20261007/print/slice/fan-tee-v4-native-actual.gcode.3mf
!/output/fan-tee-direct-print-v4-20261007/render/*.png
!/output/fan-tee-direct-print-v4-20261007/verification/reference/*.stl

# CLI preflight is not the dispatched native package. Logs, raw G-code and
# helper meshes remain covered by the generated-output rule above.
/output/fan-tee-direct-print-v4-20261007/print/bambu-cli-data/
/output/fan-tee-direct-print-v4-20261007/print/slice/*.json
/output/fan-tee-direct-print-v4-20261007/print/slice-audit.json
/output/fan-tee-direct-print-v4-20261007/print/slice-command.json
/output/fan-tee-direct-print-v4-20261007/print/slice-result.json

# Current fan delivery packages: exact clean meshes + audited native print files.
!/output/fan-tee-narrow-nozzles-v5-20261007/stl/*-clean.stl
!/output/fan76-direct-longtravel-v1-20261007/stl/*-clean.stl
!/output/fan-tee-narrow-nozzles-v5-20261007/print/slice/fan-tee-v5-native-project.3mf
!/output/fan-tee-narrow-nozzles-v5-20261007/print/slice/fan-tee-v5-native-actual.gcode.3mf
!/output/fan76-direct-longtravel-v1-20261007/print/slice/fan76-direct-v1-native-project.3mf
!/output/fan76-direct-longtravel-v1-20261007/print/slice/fan76-direct-v1-native-actual.gcode.3mf
!/output/fan76-direct-longtravel-v1-20261007/review/review-fan-envelope.stl
!/output/fan-tee-narrow-nozzles-v5-20261007/render/*.png
!/output/fan76-direct-longtravel-v1-20261007/render/*.png
!/output/fan-tee-narrow-nozzles-v5-20261007/verification/SHA256SUMS.txt
!/output/fan76-direct-longtravel-v1-20261007/verification/SHA256SUMS.txt
# Rebuilds, duplicate extracted presets and machine caches are not deliverables.
/output/fan-tee-narrow-nozzles-v5-20261007/verification/rebuild/
/output/fan76-direct-longtravel-v1-20261007/verification/rebuild/
/output/**/verification/matplotlib/
/output/fan-tee-narrow-nozzles-v5-20261007/print/bambu-cli-data/
/output/fan76-direct-longtravel-v1-20261007/print/bambu-cli-data/
/output/fan-tee-narrow-nozzles-v5-20261007/print/config/project-settings.json
/output/fan76-direct-longtravel-v1-20261007/print/config/project-settings.json
/output/fan-tee-narrow-nozzles-v5-20261007/print/slice/*.json
/output/fan76-direct-longtravel-v1-20261007/print/slice/*.json

# Ø76 v2 geometry-review delivery; no old G-code is promoted to this shell.
!/output/fan76-smooth-v2-20261008/stl/*-clean.stl
!/output/fan76-smooth-v2-20261008/review/review-fan-envelope.stl
!/output/fan76-smooth-v2-20261008/render/*.png

# Ø76 v3 longer contraction / shallow default tip; clean geometry only.
!/output/fan76-smooth-v3-20261008/stl/*-clean.stl
!/output/fan76-smooth-v3-20261008/review/review-fan-envelope.stl
!/output/fan76-smooth-v3-20261008/render/*.png

# Ø76 v4 thin-wall review: retain final meshes, images and curated estimates;
# offline comparison G-code, extracted presets and slicer logs are not releases.
!/output/fan76-smooth-v4-20261008/stl/*-clean.stl
!/output/fan76-smooth-v4-20261008/review/review-fan-envelope.stl
!/output/fan76-smooth-v4-20261008/render/*.png
/output/fan76-smooth-v4-20261008/analysis-slices/

# Ø76 v5 C3 contraction / 2mm non-mating wall; same evidence-only slice boundary.
!/output/fan76-smooth-v5-20261008/stl/*-clean.stl
!/output/fan76-smooth-v5-20261008/review/review-fan-envelope.stl
!/output/fan76-smooth-v5-20261008/render/*.png
/output/fan76-smooth-v5-20261008/analysis-slices/

# Keep the reviewed single-shell preparation and audit, not transient settings,
# diagnostics, CLI result caches or any candidate G-code awaiting GUI release.
/output/fan76-smooth-v5-20261008/print/config/project-settings.json
/output/fan76-smooth-v5-20261008/print/slice/*.json
!/output/fan76-smooth-v5-20261008/print/fan76-smooth-v5-body-only-prepared.3mf
