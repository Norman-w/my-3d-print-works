"""SmartPaddle 独立尾部线路板。

板面 = 拍柄尾端 XZ；F.Cu 朝拍柄末端（−Y）；B.Cu 朝拍头（+Y）。
KiCad：X = 柄 X，Y = 柄 Z。

器件与网络按当前电源架构：IP5305T 充放电、USB 2.0、两组 MX1.25 4P 立插线束、
专用 JST ACH 2P 电池入口、WS2812B-2020。build 后在 KiCad 中摆放布线。
"""

from "parts.ato" import Resistor
from "parts.ato" import Capacitor
from "parts.ato" import Capacitor0805
from "parts.ato" import Capacitor1206
from "parts.ato" import Diode_1N4148W
from "parts.ato" import InductorXFL4020
from "parts.ato" import LED_0603
from "parts.ato" import Omron_B3U_1000P
from "parts.ato" import WS2812B_2020
from "parts.ato" import USB4120_03_C_Vertical
from "parts.ato" import MolexPicoBlade_53398_4P_Vertical
from "parts.ato" import JST_ACH_BM02B_ACHSS_GAN_ETF_2P_Battery
from "parts.ato" import IP5305T
from "parts.ato" import TPS2553DBV
from "parts.ato" import USBLC6_2SC6
from "parts.ato" import SN74AHCT1G125


module SmartPaddleTail:
    """Butt-face UI + power island for KiCad place/route."""

    # ---- 连接器 / 开关 / 指示 ----
    usb = new USB4120_03_C_Vertical
    j_pwr = new MolexPicoBlade_53398_4P_Vertical
    j_sig = new MolexPicoBlade_53398_4P_Vertical
    j_bat = new JST_ACH_BM02B_ACHSS_GAN_ETF_2P_Battery
    sw_user = new Omron_B3U_1000P
    led_rgb = new WS2812B_2020
    led_stat = new LED_0603
    led_stat.value = "LTST-C190KGKT"

    # ---- 电源 / 接口 IC ----
    u_pmic = new IP5305T
    u_vbus_limit = new TPS2553DBV
    u_system_limit = new TPS2553DBV
    u_esd = new USBLC6_2SC6
    u_ahct = new SN74AHCT1G125
    l_boost = new InductorXFL4020

    # ---- Type-C CC ----
    r_cc1 = new Resistor
    r_cc2 = new Resistor
    r_cc1.value = "5.1k"
    r_cc2.value = "5.1k"

    # ---- IP5305T 周边 ----
    r_vin_damp = new Resistor
    r_vbus_ilim = new Resistor
    r_system_ilim = new Resistor
    r_key = new Resistor
    r_led1 = new Resistor
    r_led23 = new Resistor
    r_vin_damp.value = "2R"
    # TPS2553 Rev.F: 59k keeps IOS(max) <= 500mA; 43.2k gives
    # 544...673mA system range around the 600mA nominal row.
    r_vbus_ilim.value = "59k 1%"
    r_system_ilim.value = "43.2k 1%"
    r_key.value = "10k"
    r_led1.value = "200R"
    r_led23.value = "1k"

    c_vin = new Capacitor0805
    c_vin_damp = new Capacitor0805
    c_vout = new Capacitor1206
    c_vout2 = new Capacitor0805
    c_bat = new Capacitor0805
    c_vbus_limit = new Capacitor
    c_system_limit_in = new Capacitor
    c_system_limit_out = new Capacitor
    c_vin.value = "10uF 10V X5R/X7R"
    c_vin_damp.value = "10uF 10V X5R/X7R"
    c_vout.value = "22uF 10V X5R/X7R"
    c_vout2.value = "10uF 10V X5R/X7R"
    c_bat.value = "10uF 10V X5R/X7R"
    c_vbus_limit.value = "100nF 10V X7R"
    c_system_limit_in.value = "100nF 10V X7R"
    c_system_limit_out.value = "100nF 10V X7R"

    # KEY/WLED 是复用低边输出，必须单向隔离，避免 WLED 状态反拉用户键。
    d_key_isolate = new Diode_1N4148W

    # ---- RGB 路径 ----
    r_led = new Resistor
    c_led = new Capacitor
    c_ahct = new Capacitor
    r_led.value = "330R"
    c_led.value = "100nF"
    c_ahct.value = "100nF"

    # ---- 网络（全部用具名 signal，避免 pin↔pin 匿名网）----
    signal gnd
    signal vbus
    signal vbus_limited
    signal vbus_ilim
    signal bat_p
    signal vout_5v_raw
    signal vout_5v
    signal system_ilim
    signal sw_node
    signal user_btn
    signal v5_sw_return
    signal cc1
    signal cc2
    signal usb_dp_conn
    signal usb_dn_conn
    signal usb_dp
    signal usb_dn
    signal led_data
    signal led_ahct_y
    signal led_din
    signal led_dout
    signal pmic_key
    signal pmic_key_isolated
    signal pmic_led1
    signal pmic_led23
    signal led_stat_a
    signal vin_damp_mid

    # ========== Type-C Sink ==========
    usb.A1 ~ gnd
    usb.A12 ~ gnd
    usb.B1 ~ gnd
    usb.B12 ~ gnd
    usb.S1 ~ gnd

    usb.A4 ~ vbus
    usb.A9 ~ vbus
    usb.B4 ~ vbus
    usb.B9 ~ vbus

    usb.A5 ~ cc1
    usb.B5 ~ cc2
    r_cc1.p1 ~ cc1
    r_cc1.p2 ~ gnd
    r_cc2.p1 ~ cc2
    r_cc2.p2 ~ gnd

    usb.A6 ~ usb_dp_conn
    usb.B6 ~ usb_dp_conn
    usb.A7 ~ usb_dn_conn
    usb.B7 ~ usb_dn_conn

    # SBU1/SBU2 are not used by this USB 2.0 sink: A8 and B8 intentionally NC.

    # ========== USB ESD（靠近 Type-C）==========
    u_esd.VBUS ~ vbus
    u_esd.GND ~ gnd
    u_esd.IO1A ~ usb_dp_conn
    u_esd.IO1B ~ usb_dp
    u_esd.IO2A ~ usb_dn_conn
    u_esd.IO2B ~ usb_dn

    # VBUS 输入硬限流：普通 Type-C default/USB2 主机不会被 IP5305 的
    # 1.2A 充电设定直接过载。/FAULT 预留 NC，不能伪装成已上报状态。
    u_vbus_limit.IN ~ vbus
    u_vbus_limit.EN ~ vbus
    u_vbus_limit.GND ~ gnd
    u_vbus_limit.OUT ~ vbus_limited
    u_vbus_limit.LIMIT_SET ~ vbus_ilim
    r_vbus_ilim.p1 ~ vbus_ilim
    r_vbus_ilim.p2 ~ gnd
    c_vbus_limit.p1 ~ vbus
    c_vbus_limit.p2 ~ gnd

    # ========== 用户键（B3U-1000P SMD；按下接地；兼 IP5305T KEY + 线束）==========
    sw_user.a ~ user_btn
    sw_user.b ~ gnd

    # ========== IP5305T 一灯模式（见电源架构说明）==========
    u_pmic.VIN ~ vbus_limited
    u_pmic.BAT ~ bat_p
    u_pmic.SW ~ sw_node
    u_pmic.VOUT ~ vout_5v_raw
    u_pmic.EPAD ~ gnd
    u_pmic.KEY ~ pmic_key
    u_pmic.LED1 ~ pmic_led1
    u_pmic.LED2 ~ pmic_led23
    u_pmic.LED3 ~ pmic_led23

    l_boost.p1 ~ sw_node
    l_boost.p2 ~ bat_p

    c_vin.p1 ~ vbus_limited
    c_vin.p2 ~ gnd
    r_vin_damp.p1 ~ vbus_limited
    r_vin_damp.p2 ~ vin_damp_mid
    c_vin_damp.p1 ~ vin_damp_mid
    c_vin_damp.p2 ~ gnd

    c_vout.p1 ~ vout_5v_raw
    c_vout.p2 ~ gnd
    c_vout2.p1 ~ vout_5v_raw
    c_vout2.p2 ~ gnd
    c_bat.p1 ~ bat_p
    c_bat.p2 ~ gnd

    # 系统 5V 硬限流保护：最坏约 673mA，低电芯电压下仍把 ACH 电流
    # 控制在项目 1.5A 连续门槛附近，并给 J2 的 1A/触点留余量。
    u_system_limit.IN ~ vout_5v_raw
    u_system_limit.EN ~ vout_5v_raw
    u_system_limit.GND ~ gnd
    u_system_limit.OUT ~ vout_5v
    u_system_limit.LIMIT_SET ~ system_ilim
    r_system_ilim.p1 ~ system_ilim
    r_system_ilim.p2 ~ gnd
    c_system_limit_in.p1 ~ vout_5v_raw
    c_system_limit_in.p2 ~ gnd
    c_system_limit_out.p1 ~ vout_5v
    c_system_limit_out.p2 ~ gnd

    # LED1/VSET：200Ω + 绿 LED → GND（4.2V 电芯，无 RVSET）
    r_led1.p1 ~ pmic_led1
    r_led1.p2 ~ led_stat_a
    led_stat.a ~ led_stat_a
    led_stat.c ~ gnd

    # LED2/VTHS + LED3 短接后经 1k → BAT
    r_led23.p1 ~ pmic_led23
    r_led23.p2 ~ bat_p

    # KEY：经 10k + 单向二极管到按键。按下仍可拉低 KEY；若长按把
    # KEY/WLED 切为低边照明输出，二极管反偏，不能持续拉低 user_btn。
    r_key.p1 ~ pmic_key
    r_key.p2 ~ pmic_key_isolated
    d_key_isolate.anode ~ pmic_key_isolated
    d_key_isolate.cathode ~ user_btn

    # ========== MX1.25 两组 4P 立插（原 8P 按电源/信号拆分）==========
    # j_pwr：粗线 / 功率与采样
    j_pwr.p1 ~ vout_5v
    j_pwr.p2 ~ gnd
    j_pwr.p3 ~ bat_p
    j_pwr.p4 ~ v5_sw_return

    # j_bat：JST ACH 专用 1S 电池入口；Pin 1=BAT_P/red，Pin 2=GND/black。
    # J2.3 继续把同一 BAT_P 网送往主板采样；电池不得接 vout_5v。
    j_bat.BAT_P ~ bat_p
    j_bat.GND ~ gnd

    # j_sig：USB 差分 + 按键 + RGB
    j_sig.p1 ~ usb_dn
    j_sig.p2 ~ usb_dp
    j_sig.p3 ~ user_btn
    j_sig.p4 ~ led_data

    # ========== WS2812：由主板开关后 5V 回供，经 AHCT ==========
    u_ahct.VCC ~ v5_sw_return
    u_ahct.GND ~ gnd
    u_ahct.OE_N ~ gnd
    u_ahct.A ~ led_data
    u_ahct.Y ~ led_ahct_y
    r_led.p1 ~ led_ahct_y
    r_led.p2 ~ led_din
    c_ahct.p1 ~ v5_sw_return
    c_ahct.p2 ~ gnd

    led_rgb.VDD ~ v5_sw_return
    led_rgb.VSS ~ gnd
    led_rgb.DIN ~ led_din
    led_rgb.DOUT ~ led_dout
    c_led.p1 ~ v5_sw_return
    c_led.p2 ~ gnd
