{
  "name": "SmartPaddle CAD + PCB + Firmware",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "agentCanUpdateSnapshot": true,
  "install": "bash .cursor/install.sh",
  "start": "pgrep -x Xvfb >/dev/null || (Xvfb :99 -screen 0 1440x900x24 >/tmp/smartpaddle-xvfb.log 2>&1 &)",
  "ports": [
    {
      "name": "SmartPaddle Web",
      "port": 5173
    },
    {
      "name": "SmartPaddle API",
      "port": 8000
    },
    {
      "name": "M6 STL Assets",
      "port": 8765
    }
  ]
}
