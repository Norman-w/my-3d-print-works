// SmartPaddle — Split-Shell Paddle Enclosure
// Front/back halves, print face-down, PETG
//
// Usage:
//   Set HALF = "front"  → front shell (red rubber side, screw thru-holes)
//   Set HALF = "back"   → back shell  (black rubber side, USB-C, pilot holes)
//   Set HALF = "both"   → assembly preview

include <parameters.scad>

// ═══ CONFIG ═══
USE_BEZIER_PROFILES = true; // false = legacy ellipse + FL handle
// Outer skin: OpenSCAD CSG union (watertight). Live STL merge is preview-only.
USE_IMPORTED_OUTER = false;
HALF = "front"; // "front" | "back" | "both"
LOFT_SLICES = USE_BEZIER_PROFILES ? 64 : 150;

// Generated by scripts/bezier_to_openscad.py (required when USE_BEZIER_PROFILES=true)
include <generated/bezier_geometry.scad>
include <bezier_profile.scad>

$fn = 80;
eps = 0.02;
BIG = 300;

// ═══ Utility ═══

function smoothstep(t) = t * t * (3 - 2 * t);

function fl_half_w(t) =
    let(waist_t = 0.32, n = handle_neck_w/2, b = handle_butt_w/2)
    t <= waist_t
        ? n * (1 - 0.06 * sin(t / waist_t * 90))
        : n * 0.94 + (b - n * 0.94) * smoothstep((t - waist_t) / (1 - waist_t));

function blade_hx(y) =
    let(t = (y - blade_ellipse_cy) / blade_ellipse_b)
    abs(t) >= 1 ? 0 : blade_ellipse_a * sqrt(1 - t*t);

function legacy_paddle_hx(y) =
    y >= shoulder_top_y ? blade_hx(y) :
    y >= shoulder_bottom_y ?
        blade_hx(shoulder_top_y) + (handle_neck_w/2 - blade_hx(shoulder_top_y)) *
            smoothstep((y - shoulder_top_y) / (shoulder_bottom_y - shoulder_top_y)) :
    y >= handle_butt_y ? fl_half_w((y - handle_join_y) / (-handle_length)) : 0;

function legacy_half_z_at(y) =
    y >= shoulder_top_y ? blade_half_t :
    y >= shoulder_bottom_y ?
        blade_half_t + (handle_half_t - blade_half_t) *
            smoothstep((y - shoulder_top_y) / (shoulder_bottom_y - shoulder_top_y)) :
    handle_half_t;

function paddle_hx(y) = legacy_paddle_hx(y);

function half_z_at(y) =
    USE_BEZIER_PROFILES ? bezier_half_z_at(y) : legacy_half_z_at(y);

function sign(x) = x >= 0 ? 1 : -1;

// ═══ Rounded Rectangle (XZ plane) ═══

module rounded_rect(w, h, r) {
    rr = min(r, w/2 - eps, h/2 - eps);
    hull()
        for (sx = [-1, 1], sy = [-1, 1])
            translate([sx * (w/2 - rr), sy * (h/2 - rr)])
                circle(r = rr);
}

// ═══ Full Paddle Outer Solid (centered at Z=0) ═══

module paddle_outer() {
    if (USE_BEZIER_PROFILES && USE_IMPORTED_OUTER) {
        import("stl/outer_envelope.stl", convexity = 10);
    } else if (USE_BEZIER_PROFILES) {
        bezier_paddle_outer();
    } else {
        steps = LOFT_SLICES;
        y0 = handle_butt_y;
        y1 = blade_tip_y;
        dh = (y1 - y0) / steps;
        for (i = [0:steps-1]) {
            ym = y0 + (i + 0.5) * dh;
            hx = paddle_hx(ym);
            hz = half_z_at(ym);
            if (hx > 0.05) {
                translate([0, ym, 0])
                rotate([90, 0, 0])
                    linear_extrude(height = dh + eps, center = true) {
                        if (ym >= shoulder_top_y) {
                            scale([hx, hz]) circle(r = 1);
                        } else {
                            rounded_rect(hx * 2, hz * 2, handle_corner_r);
                        }
                    }
            }
        }
    }
}

// ═══ Inner Cavity Shell (subtracted from outer) ═══

module handle_cavity() {
    // Hollow handle only; blade face stays solid
    if (USE_BEZIER_PROFILES) {
        bezier_handle_cavity();
    } else {
        steps = 80;
        y0 = handle_butt_y + wall_t;
        y1 = shoulder_top_y + 5;
        dh = (y1 - y0) / steps;
        for (i = [0:steps-1]) {
            ym = y0 + (i + 0.5) * dh;
            outer_hx = paddle_hx(ym);
            outer_hz = half_z_at(ym);
            inner_hx = outer_hx - wall_t - handle_cavity_inset;
            inner_hz = outer_hz - wall_t - handle_cavity_inset;
            if (inner_hx > 0.5 && inner_hz > 0.5) {
                translate([0, ym, 0])
                rotate([90, 0, 0])
                    linear_extrude(height = dh + eps, center = true) {
                        if (ym >= shoulder_top_y) {
                            scale([inner_hx, inner_hz]) circle(r = 1);
                        } else {
                            rounded_rect(inner_hx * 2, inner_hz * 2,
                                max(1.5, handle_corner_r - 1));
                        }
                    }
            }
        }
    }
}

// ═══ Screw Bosses (positive columns) ═══

module screw_bosses() {
    for (p = screw_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        boss_h = hz - wall_t;  // from inner wall to split plane
        if (boss_h > 1) {
            translate([x, y, 0])
                cylinder(d = screw_d_boss, h = boss_h, center = false);
        }
    }
}

// Bosses for back half (negative Z direction)
module screw_bosses_back() {
    for (p = screw_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        boss_h = hz - wall_t;
        if (boss_h > 1) {
            translate([x, y, -boss_h])
                cylinder(d = screw_d_boss, h = boss_h, center = false);
        }
    }
}

// ═══ Screw Holes ═══

module screw_holes_clearance() {
    // Clearance through front half + countersink
    for (p = screw_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        // Through hole
        translate([x, y, -eps])
            cylinder(d = screw_d_clearance, h = hz + eps);
        // Countersink from outer face
        translate([x, y, hz - screw_head_d/2 + eps])
            cylinder(d1 = screw_head_d, d2 = 0, h = screw_head_d/2);
    }
}

module screw_holes_pilot() {
    // Pilot holes in back half for M2 self-tapping
    for (p = screw_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        // Drill from split plane inward ~60% of wall depth
        drill_h = (hz - wall_t) * 0.7;
        translate([x, y, -drill_h])
            cylinder(d = screw_d_pilot, h = drill_h + eps);
    }
}

// ═══ Silicone Plug Recesses (on outer face) ═══

module plug_recesses() {
    for (p = screw_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        translate([x, y, hz - plug_recess_depth + eps])
            cylinder(d = plug_recess_d, h = plug_recess_depth + eps);
    }
}

// ═══ Piezo Sensor Pockets ═══

module piezo_pockets() {
    for (p = piezo_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        pd = min(piezo_disc_depth, hz - wall_t - 0.3);
        if (pd > 0.2) {
            // Pocket from split plane into the shell body
            translate([x, y, -eps])
                cylinder(d = piezo_disc_d, h = pd + eps);
        }
    }
}

// ═══ Wire Routing Channels ═══

module wire_channels() {
    // From each piezo position to the handle cavity entrance
    entry_y = shoulder_bottom_y + 8;
    for (p = piezo_positions) {
        px = p[0]; py = p[1];
        // Straight channel from piezo to handle entry
        hull() {
            translate([px, py, -eps])
                cylinder(d = piezo_trench_w, h = piezo_trench_d + eps);
            translate([sign(px) * tang_half_w, entry_y, -eps])
                cylinder(d = piezo_trench_w, h = piezo_trench_d + eps);
        }
    }
}

// ═══ USB-C Opening ═══

module usb_c_cutout() {
    // At handle butt, centered
    translate([0, handle_butt_y, -usb_c_h/2])
        rotate([90, 0, 0])
            linear_extrude(height = usb_c_depth + eps)
                square([usb_c_w, usb_c_h], center = true);
}

// ═══ Alignment Pins & Sockets ═══

module alignment_pins() {
    // Positive pins (on front half, stick into back half)
    for (p = pin_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        if (hz > wall_t + pin_h + 1) {
            translate([x, y, 0])
                cylinder(d = pin_d, h = pin_h);
        }
    }
}

module alignment_sockets() {
    // Socket holes (in back half, receive pins from front)
    for (p = pin_positions) {
        x = p[0]; y = p[1];
        hz = half_z_at(y);
        if (hz > wall_t + pin_h + 1) {
            translate([x, y, -eps])
                cylinder(d = pin_d + pin_socket_clearance * 2, h = pin_h + 1);
        }
    }
}

// ═══ Blade Internal Ribs ═══

module blade_ribs() {
    for (y = [shoulder_top_y + rib_spacing : rib_spacing : blade_tip_y - 15]) {
        hx = paddle_hx(y) - wall_t - 3;
        hz = half_z_at(y) - wall_t - blade_inner_floor;
        if (hx > 3 && hz > 0.3) {
            translate([0, y, wall_t])
            rotate([90, 0, 0])
                linear_extrude(height = rib_t, center = true)
                    scale([hx, hz])
                        circle(r = 1);
        }
    }
}

// ═══ Front Half ═══

module front_half() {
    difference() {
        union() {
            // Outer shell half (Z >= 0)
            intersection() {
                paddle_outer();
                translate([0, 0, -eps])
                    cube([BIG, BIG, BIG], center = true);
            }
            // Screw bosses
            screw_bosses();
            // Blade ribs
            blade_ribs();
        }

        // Hollow out handle + shoulder
        handle_cavity();

        // Screw clearance holes + countersinks
        screw_holes_clearance();

        // Piezo disc pockets
        piezo_pockets();

        // Wire channels
        wire_channels();

        // Plug recesses on outer face
        plug_recesses();
    }

    // Alignment pins (stick into back half)
    alignment_pins();
}

// ═══ Back Half ═══

module back_half() {
    difference() {
        union() {
            // Outer shell half (Z <= 0)
            intersection() {
                paddle_outer();
                translate([0, 0, BIG/2])
                    cube([BIG, BIG, BIG], center = true);
            }
            // Screw bosses (negative Z direction)
            screw_bosses_back();
            // Blade ribs
            blade_ribs();
        }

        // Hollow out handle + shoulder
        handle_cavity();

        // Pilot holes for self-tapping
        screw_holes_pilot();

        // Piezo disc pockets (shallower — shared with front)
        piezo_pockets();

        // Wire channels
        wire_channels();

        // USB-C at handle butt
        usb_c_cutout();

        // Alignment sockets (receive front pins)
        alignment_sockets();

        // Plug recesses on outer face
        plug_recesses();
    }
}

// ═══ Render ═══

if (HALF == "front") {
    front_half();
} else if (HALF == "back") {
    back_half();
} else if (HALF == "both") {
    %front_half();
    back_half();
}

echo(str("=== SmartPaddle Shell ==="));
echo(str("Profile: ", USE_IMPORTED_OUTER ? "Live outer STL (Three.js)" :
    USE_BEZIER_PROFILES ? "bezier SCAD loft" : "legacy ellipse"));
echo(str("Loft slices: ", LOFT_SLICES));
echo(str("Total height: ", blade_tip_y - handle_butt_y, "mm"));
echo(str("Blade: ", blade_width, "mm wide × ", blade_core_t, "mm thick"));
echo(str("Handle: ", handle_length, "mm FL, ", handle_neck_w, "→", handle_butt_w, "mm"));
echo(str("Half: ", HALF));
echo(str("Screws: ", len(screw_positions), "× M2"));
