// SmartPaddle — 参数化壳体配置
// 前/后分壳乒乓球拍外壳，用于 3D 打印
// 所有尺寸单位：mm

// ════════════════════════════════════════════════════════════════
// 1. 拍头 (Blade)
// ════════════════════════════════════════════════════════════════
//
//           正视图 (拍面朝外, +Y ↑ 为拍尖方向)
//
//                  .,-─-..                     ── 拍尖 Y=+78.5
//               ,-'"       "'-.
//             ,"               ".
//           ╱                     ╲
//          ╱         ②            ╲
//         /         ┌──┐          \           ← 拍面宽 150mm
//        /           │①│           \
//       /            └──┘            \
//      ╱            ③               ╲         ← 甜区 (含 PCB 区)
//     /         ②           ②        \
//    ╱         ┌──┐          ┌──┐     ╲
//   ╱          │①│           │①│      ╲
//   ╲          └──┘           └──┘      ╱
//    ╲        ──④──           ──④──    ╱        ← 螺丝柱 12×M2
//     ╲                                 ╱
//      ╲           ⑤        ⑤         ╱         Y = -71.7 (肩膀区)
//       ╲                               ╱
//    ────╲─────────────────────────────╱──── Y = -78.5 (手柄接合)
//          ╲                           ╱
//           ╲          ⑥             ╱            ← ⑥ 走线槽 (电源+信号)
//            "、                     ,"
//              "、                 ,"
//                "''-.._____..-''"
//
//   图例:
//   ① PCB 槽 (42×42mm) — IM948 十轴 IMU (上) + ESP32-C6 MCU (下) 纵排
//   ② PZT-5A 压电片 (Ø20×1mm) — 4 片分布在甜区四角, 含信号调理耳槽
//   ③ 甜区中心击球面 — 包含 PCB 区在内, 前后壳各半壁厚
//   ④ 螺丝柱 — 12 颗 M2 自攻螺丝, 含沉头穿过的定位销
//   ⑤ 肩膀 / 颈部过渡 — 拍面渐收至手柄, 半宽 9mm
//   ⑥ 走线槽 — 电源 (VCC+GND) + 压电信号 → 手柄, 左右各一条

// ---- 拍头外形 (Butterfly Timo Boll ALC 参考) ----
blade_width          = 150;       // 拍头最大宽度 (X)，仅文档参考
blade_tip_y          = 78.5;      // 拍尖 Y 坐标
blade_ellipse_a      = 75;        // 椭圆半长轴 X (仅传统模式)
blade_ellipse_cy     = -10;       // 椭圆中心 Y 偏移 (仅传统模式)
blade_ellipse_b      = 88;        // 椭圆半短轴 Y (仅传统模式)
blade_core_t         = 6.0;       // 拍头总厚度 (Z)

// ---- 肩膀 / 颈部过渡 ----
shoulder_top_y       = -71.7;     // 肩膀起始 Y
shoulder_bottom_y    = -78.5;     // 肩膀结束 Y (手柄接合处)
tang_half_w          = 9;         // 颈部半宽 (拍头-手柄接合处)

// ---- 壁厚与加强筋 ----
wall_t               = 2.0;       // 外壳壁厚
rib_t                = 2.0;       // 内部加强筋厚度
rib_spacing          = 18;        // 拍头区加强筋间距 (mm)
blade_inner_floor    = 1.5;       // 压电槽上方底板厚度

// ---- 尾板（pcb-tail）机械接口：外形/环槽/Step6 共用 ----
tail_board_t                    = 1.00;  // 板厚
tail_board_y_from_butt          = 5.80;  // F.Cu 距拍尾 = Type-C 身体高度
tail_board_ring_groove_radial   = 0.50;  // 内壁环槽径向深度
tail_cavity_inset               = 0.80;  // 尾端截面内缩（板外形用；异于下面 handle_cavity_inset）

// ---- 螺丝孔与硅胶塞 (M2 自攻螺丝，PETG 材质) ----
screw_d_clearance    = 2.2;       // 螺丝过孔直径 (M2 光杆 2.0 + 容差 0.2)
screw_d_boss         = 5.5;       // 螺丝柱外径
screw_d_pilot        = 1.5;       // 自攻底孔直径 (M2 PETG 塑料自攻，75% 啮合率)
screw_head_d         = 3.8;       // M2 沉头螺钉头部直径 (标准 ~3.8mm)
plug_recess_d        = 6.0;       // 硅胶塞凹槽直径
plug_recess_depth    = 2.0;       // 硅胶塞凹槽深度

// 两颗螺丝穿过刚性 PCB；板上已为它们留孔，后壳必须在同轴位置保留 boss。
pcb_through_screw_positions = [
    [0, -33],   // 大陆下方，KiCad (0, 23)
    [0, -89],   // PCB 尾巴，KiCad (0, 79)
];

// 螺丝位 [X, Y]，坐标原点为椭圆中心 Y=0
screw_positions = [
    [0,    65],   // 拍尖正中
    [52,   45],   // 右上
    [-52,  45],   // 左上
    [55,    0],   // 右中
    [-55,   0],   // 左中
    [36,  -65],   // 右下
    [-36, -65],   // 左下
    [0,   32],   // 拍面中轴（不穿 PCB）
    pcb_through_screw_positions[0],
    [7,  -160],   // 手柄右侧
    [-7, -160],   // 手柄左侧
    pcb_through_screw_positions[1],
];

// ════════════════════════════════════════════════════════════════
// 2. 拍面甜区电子元器件 (方案A · V1)
// ════════════════════════════════════════════════════════════════
//
// 布局: IM948 裸板 (13×18.5×3mm) + ESP32-C6-N8 (25×18×3mm)
//       沿拍头→拍柄方向 (Y 轴) 纵排。
//       IMU 在上 (拍头侧)，MCU 在下 (拍柄侧)，均居中于拍头-拍柄中线 (X=0)。
//       正方形槽体：横拍/直拍皆可保持正确的 X-Y 方位。
//
// ⚠️ 已知坑：ESP32-C6 无硬件 FPU（RISC-V 无 F 扩展）。
//    单精度浮点 cos() 比带 FPU 的 ESP32-S3 慢 ~20×（2377 vs 121 周期）。
//    双 IMU 传感器融合（Mahony/Madgwick）必须用定点数实现。
//    方案B (V2) 将升级为带 FPU 的 ESP32-S3。

// ---- PCB 槽体 ----
pcb_cavity_center     = [0, -1];     // 槽体中心 [X,Y]，IMU 居拍头-拍柄中线 (向拍头扩展 8mm)
pcb_cavity_size       = [42, 50];    // 矩形 42×50：Y 向向拍头扩展 8mm 给布线留空间
pcb_cavity_depth      = 1.5;         // 每半壳槽深 (总计 3mm，剩余壁厚 1.5mm)

// ---- 模块放置偏移 (SCAD 坐标, 相对 pcb_cavity_center) ----
// IMU (IM948, 13×18.5×3mm): 靠拍头侧，往拍柄方向挪 3mm 留空间。
//   X=0 居中；Y=12.5 = 大陆中心 + 12.5mm 向拍头（原 15.5，向拍柄收 3mm）
imu_module_offset     = [0, 12.5];
// MCU (ESP32-C6-N8, 25×18×3mm): 靠拍柄侧，偏左留 IMU 信号区。
//   X=-3 偏左 3mm；Y=-8 = 向 IMU/拍头靠拢（原 -11.5；与 IMU 短边间隙约 5mm）
mcu_module_offset     = [-3, -8];

// ---- PCB 尾部连接器 (MX1.25 / PicoBlade 正反各 5P 卧贴) ----
// 信号仍 10 路；壳体半宽对齐粗栈道 (~9mm)，无金手指窄尖
tail_connector_pitch  = 1.25;      // MX1.25 间距 (mm)
tail_connector_pins   = 5;         // 每面 5P ×2 = 10 信号
tail_connector_pcb_w  = 18.00;     // 尾端 PCB 全宽 ≈ 2×_tail_base_hw (mm)

// ---- 电源通道 (电池在拍柄 → ESP32 在拍面甜区) ----
// 左右各一条槽走 VCC+GND，经由拍面-手柄连接处进入手柄空腔。
signal_trench_w       = 2.0;        // 槽宽 (VCC+GND 两条线)
signal_trench_d       = 1.0;        // 槽深 (信号线槽，剩余壁厚 ≥2mm)

// ---- 压电片传感器槽位 (PZT-5A 陶瓷裸片) ----
// 选用 PZT-5A 翻边型裸陶瓷片 (家铭电子), 20mmØ × 1mm 厚
// 翻边型正负极同面，平面侧贴拍面内壁，电极面向内腔。
// 尺寸含 FDM 打印容差 + 拆装间隙。
piezo_disc_d         = 20.5;      // 槽位直径 (PZT 20mm + 0.5mm 容差)
piezo_disc_depth     = 1.1;       // 槽深 (PZT 1mm + 0.1mm 焊点余量)
piezo_trench_w       = 3.0;       // 引线槽宽度
piezo_trench_d       = 1.2;       // 引线槽深度 (AWG30 线径 ≈0.25mm，余壁厚 ≥1.8mm)
// 槽位中心需在拍面轮廓内 (20mm 圆片 + ~3mm 边缘余量)
piezo_positions = [
    [38,  52],   // 右上 (近拍尖)
    [-38, 52],   // 左上
    [44, -52],   // 右下 (近肩膀)
    [-44,-52],   // 左下
];

// ---- PZT 信号调理元件槽 ----
// 紧贴 PZT 槽边缘，朝向 MCU 汇聚点延伸，最短信号路径。
// 容纳：1MΩ 电阻 (0603) + BAT54S 双肖特基二极管 (SOT-23)
resistor_ear_w        = 6.0;       // 耳槽宽度 (0603 + SOT-23 并排 + 容差)
resistor_ear_l        = 8.0;       // 耳槽长度 (从 PZT 槽边缘往外，加长防毛刺)
resistor_ear_d        = 1.2;       // 耳槽深度 (与引线槽同深)

// ════════════════════════════════════════════════════════════════
// 3. 拍柄 (Handle)
// ════════════════════════════════════════════════════════════════
//
//           正视图 (拍柄方向, +Y ↑ 为拍头)
//
//   接合处 Y=-78.5 ─╥──────┬──────╥────
//                    ║  ┌───┴───┐  ║      ← 颈部宽 24mm, 壁厚 2mm
//                    ║  │  ⑦   │  ║
//                    ║  ╞═══════╡  ║      ← 手柄厚 26mm, 倒角 R=4
//                    ║  │  ⑧   │  ║
//                    ║  ╞══╤════╡  ║
//                    ║  │⑨│ ⑨ │  ║      ← ⑨ 电路槽 (电池+充电板+软开关)
//                    ║  └──┴────┘  ║
//                    ║   ╲      ╱  ║      ← FL 渐扩 24mm → 34mm
//                    ║    ╲    ╱   ║
//                    ║     ╲  ╱    ║
//   尾端 Y=-178.5 ──╨══════╧══════╨──
//                    ←── 100mm ──→
//
//   图例:
//   ⑦ 手柄空腔 — 容纳电池 (10440 Φ10×44mm 或 14500 Φ14×50mm)
//   ⑧ 走线槽 — 电源+信号从手柄通往拍面甜区
//   ⑨ 电路元件槽 — TP4056 充电板 + 软开关电路 (AO3401+1N4148+100kΩ)
//
//        端面视图 (从外往里看, 位于 Y=-178.5)
//
//   前壳外表面 Z=+13 ━━━━━━━━
//   ┌───────────────────────┐
//   │  ● Ⓐ                  │   ← Ⓐ 充电灯 (X=-5, Z=+2, 前壳)
//   │                        │
//   │          ╔═╗           │   ← Ⓑ USB-C 竖放 (X:±1.8, Z:±4.9, 跨分型面)
//   │          ║ ║           │
//   │          ║ ║           │
//   │          ╚═╝    ○     │   ← Ⓒ 按钮 (X=+9, 两段式台阶孔)
//   │                        │
//   │  ● Ⓓ                   │   ← Ⓓ WS2812 RGB (X=-5, Z=-5, 后壳)
//   └───────────────────────┘
//   后壳外表面 Z=-13 ━━━━━━━━
//   ────── Z=0 (分型面) ───────

// ---- 拍柄外形 ----
handle_thickness     = 26;        // 拍柄总厚度 (Z)
// 以下 4 个参数仅用于传统 FL 公式模式 (USE_BEZIER_PROFILES=false)，
// 贝塞尔模式由曲线直接控制形状，无需修改此处。
// handle_length, handle_neck_w, handle_butt_w, handle_corner_r → 见末尾 legacy 区

// ---- 派生坐标 ----
handle_join_y        = -78.5;     // 拍头-拍柄接合处 Y 坐标
handle_butt_y        = -178.5;    // 拍柄尾端 Y 坐标

// ---- 内腔与壁厚 ----
handle_cavity_inset  = 1.5;       // 内腔额外内缩量 (总壁厚 = wall_t + inset)

// ---- M6 四层连续承力结构 ----
// Z+ → Z-：拍柄正面外贴 / 正面主承力层 / 背面主承力层 / 拍柄背面外贴。
// 主承力层沿 XY 覆盖拍头和完整拍柄；拍柄中控腔与尾板空间仍按原参数切除。
m6_core_half_t            = blade_core_t / 2;  // 每块主承力层厚度
m6_union_overlap          = 0.15; // 合体导出时外贴层压入主层，避免零厚度接触
m6_handle_wall_t          = wall_t + handle_cavity_inset;
// 两组沉头自攻螺丝从中间贴合面分别穿过第 2/3 层，向外咬入第 1/4 层。
// 依据核心层/腔壁中较薄者选择通用直径；当前 3mm 可用壁厚得到 M1.2。
m6_fastener_available_wall = min(m6_core_half_t, m6_handle_wall_t);
m6_handle_screw_d         =
    m6_fastener_available_wall < 2.0 ? 1.0 :
    m6_fastener_available_wall < 3.5 ? 1.2 :
    m6_fastener_available_wall < 4.5 ? 1.4 : 1.6;
m6_handle_screw_clearance = m6_handle_screw_d + 0.20;
m6_handle_screw_pilot     = m6_handle_screw_d * 0.75;
m6_handle_screw_head_d    = m6_handle_screw_d * 1.90;
m6_handle_screw_head_h    = m6_handle_screw_d * 0.60;
m6_handle_boss_d          =
    m6_handle_screw_d + 2 * min(1.40, m6_handle_wall_t - 0.5);
m6_handle_back_skin_min   = 0.80; // 螺丝尖端与外层表面间的安全余量
m6_handle_engagement_min  = 2.0;
m6_handle_engagement_max  = 4.0;
m6_handle_screw_lengths   = [4, 5, 6, 7, 8, 10]; // 常见 M1.x 沉头自攻长度
// 沿贝塞尔外轮廓与内腔轮廓的中线等弧长自动排布；不保存固定 XY 坐标。
m6_handle_screw_station_count = 4; // 每个面沿长度方向的左右成对站位数
m6_handle_screw_top_clearance = 10; // 距头柄接合线的净距
m6_handle_screw_bottom_clearance = 8; // 距拍柄尾端的净距

// ---- 分打拍柄：朝拍头端 U 型插口（仅 handle_* 零件） ----
// 拍柄合模后朝拍头一侧原先四周严丝合缝，拍面颈部插不进。
// 分打时用完整拍面颈部实体（带间隙）直接减拍柄，成同形夹口让拍面插入。
handle_blade_socket_clearance = 0.4;  // 插装余量 (mm)

// ---- 尾端安全延伸 ----
// 贝塞尔绘制时可能略微加长拍柄，此时 BEZIER_Y0 会比 handle_butt_y 更往下。
// 此值为在贝塞尔实际底端之外额外延伸的长度，确保 USB-C/按钮/LED 等开孔永远从
// 壳体外侧切入，不会卡在壳体内部。
handle_extend_y      = 5;         // 尾端延伸量 (mm)，开孔 = min(handle_butt_y, BEZIER_Y0) - 此值

// ════════════════════════════════════════════════════════════════
// 4. 拍柄端面开孔参数（历史：外购 TP4056 充电总成）
// ════════════════════════════════════════════════════════════════
// DEPRECATED：外购充电总成已废弃；充电/USB/按键/LED 改由 pcb-tail 自研尾板实现。
// paddle_shell.scad 的 handle_*_part 不再调用下列开孔/基台/夹持模块。
// 参数暂留以免其他脚本引用断裂；新开孔请走 Step6（pcb-tail KiCad 干涉）。

// ---- USB-C 母座两段式台阶开口 ═══
//
//   拍柄尾端截面 (从外往里看, Y- → Y+)：
//
//     [壳外] ──── 内圈(公头) ──── 外圈(母座体) ──── [腔体]
//             ←── 1mm台阶 ──→  ←── 深约13mm ──→
//             公头可插入        母座体被台阶卡住
//
//   内圈 = 外面看到的开口 = 公头大小 (宽Z × 厚X)
//   外圈 = 腔体内的套圈 = 母座外壳外尺寸 + 0.5mm (母座体容纳)
//   母座从腔体向外推入，外圈容纳母座体，1mm 台阶挡住母座不脱出。
//   中心在分型面 Z=0、X=0。
//
//   母座外壳典型尺寸: Z≈9.5mm, X≈3.5mm；外圈 = 母座外 + 0.5mm ≈ 10×4mm。
usb_c_opening_x      = 2.9;       // 内圈窄边 X (公头厚度 2.4 + 0.5)
usb_c_opening_z      = 8.5;       // 内圈宽边 Z (公头宽度 8.0 + 0.5)
usb_c_opening_r      = 0.5;       // 内圈圆角
usb_c_socket_x        = 4.0;      // 外圈窄边 X (母座外壳 3.5 + 0.5)
usb_c_socket_z        = 10.0;     // 外圈宽边 Z (母座外壳 9.5 + 0.5)
usb_c_socket_r        = 0.5;      // 外圈圆角
usb_c_retain_t       = 1;         // 挡皮/台阶厚度
usb_c_z              = 0;         // Z 中心 (分型面)

// ---- 充电状态 LED 导光孔 (TP4056 红/绿共用，仅前壳) ----
led_hole_d           = 2.0;       // 导光柱孔直径
led_charge_x         = -5;        // 充电灯 X (左侧)
led_charge_z         = 2;         // 充电灯 Z (前壳侧)
led_hole_depth       = 13;        // 钻孔深度 (8mm 标准 + 5mm 容差)

// ---- 用户交互 LED 导光孔 (WS2812-2020，仅后壳) ----
ws2812_led_hole_d     = 2.0;      // 导光孔直径
ws2812_led_x          = -5;       // LED X (左侧)
ws2812_led_z          = -5;       // LED Z (后壳侧)
ws2812_led_hole_depth = 10;       // 钻孔深度 (5mm 标准 + 5mm 容差)

// ---- 软开关按钮 (开口在分型面，前后各半，开关从分型面安入) ----
// 4.5×4.5mm 轻触开关（按钮柱 Ø2.4mm，底座正方形），
// 淘宝搜索: `4.5*4.5 轻触开关` 或 `4.5×4.5 侧按开关`。
//
//   Y-Z 截面 (从内到外，X=9 处)：
//
//        [ 内腔 ] ─── 立柱 ─── 开关体 ─── 外壁1mm ─── [壳外]
//        焊爪伸入    X=3       4.5×4.5     Ø3mm孔
//                    Y=5       3mm厚       按钮柱露出
//                    Z=全壳厚
//                    ↑ 两侧 1mm 间隙走焊爪
//
//   通道 (减法): 5×5mm 矩形管道，从外壁内侧深挖 9mm 到腔体。
//   立柱 (加法): 3×5mm 实心柱，从分型面 (Z=0) 接到外壳壁面 (Z=±9)。
//   立柱 Z 向一体化接到壳壁，提供按压时的反力支撑。
//   安装：前后壳分开时，开关从分型面放入通道，外壁 1mm 挡出，
//         立柱顶住开关背面防按压沉入，两侧各 1mm 间隙过焊爪导线。
//   X=+9，与 USB-C 右缘 (X=+1.8) 间距 >5mm。
button_cap_d         = 3.0;       // 按钮柱通孔直径 (按钮柱 2.4 + 0.6 容差)
button_pocket_w      = 5.0;       // 开关体方槽/通道边长 (4.5 开关 + 0.5 容差)
button_wall_t        = 1;         // 外壁厚度 (开关与壳外之间的皮)
button_x             = 9;         // 按钮 X (右侧，远离 USB-C)
button_z             = 0;         // 按钮 Z (分型面，前后各半)

// ---- 软开关电路元件槽 (AO3401 + 1N4148×2 + 100kΩ，死虫焊) ----
soft_power_cavity_w  = 6;         // 槽宽
soft_power_cavity_l  = 8;         // 槽长
soft_power_cavity_d  = 1.5;       // 槽深

// ════════════════════════════════════════════════════════════════
// 5. 定位销
// ════════════════════════════════════════════════════════════════

pin_d                = 3.0;       // 定位销直径
pin_h                = 4.0;       // 定位销高度
pin_socket_clearance = 0.3;       // 销孔间隙 (销径 + clearance)
pin_positions = [
    [45,  40], [-45, 40],
    [48, -30], [-48,-30],
    [10, -120], [-10,-120],
];

// ════════════════════════════════════════════════════════════════
// 6. 派生参数 (勿手动修改)
// ════════════════════════════════════════════════════════════════

blade_half_t = blade_core_t / 2;  // 每半壳拍头厚度
handle_half_t = handle_thickness / 2;  // 每半壳拍柄厚度

