CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TIMER_IMPL_TIMG=y
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# WiFi 配置
CONFIG_ESP_WIFI_SSID="SmartPaddle"
CONFIG_ESP_WIFI_PASSWORD="paddle123"
CONFIG_ESP_WIFI_CHANNEL=1
CONFIG_ESP_MAX_STA_CONN=4

# HTTP 服务器
# 华为/小米等 captive portal 探测请求头很长，512 会报 Header fields are too long
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y

# mDNS
CONFIG_MDNS_MAX_SERVICES=4

# UART 配置（UART0 用于 USB 控制台，UART1 留给 IM948）
CONFIG_ESP_CONSOLE_UART_NUM=0

# status_led 使用 led_strip(new RMT)；压电已改为 GPIO ISR，不再占用 RMT RX
