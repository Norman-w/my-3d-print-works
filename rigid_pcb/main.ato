"""SmartPaddle rigid PCB logic.

This file is the intended source of truth for electrical connectivity.
KiCad-side scripts may maintain mechanical reference drawings, edge cuts,
and special generated pads, but nets should be mirrored from here instead of
being invented inside geometry scripts.
"""

from "parts.ato" import Resistor
from "parts.ato" import Capacitor
from "parts.ato" import Diode
from "parts.ato" import BAT54S
from "parts.ato" import PChannelMOSFET_SOT23
from "parts.ato" import NChannelMOSFET_SOT23
from "parts.ato" import AP2112K_3V3
from "parts.ato" import WirePad
from "parts.ato" import SmallWirePad
from "parts.ato" import EdgeFingerPad


component SGFK_ESP32C6N8_Cutout:
    designator_prefix = "J"
    pin GND_1
    pin VCC_3V3
    pin EN
    pin GPIO2_PZT_TL
    pin GPIO3_PZT_TR
    pin GPIO6_PZT_BL
    pin GPIO7_PZT_BR
    pin GPIO8_LED_DATA
    pin GPIO9_BOOT
    pin GPIO10_USER_BTN
    pin PWR_LATCH
    pin USB_DP
    pin USB_DN
    pin UART_TX
    pin UART_RX
    pin GND_28

    GND_1 ~ pin 1
    VCC_3V3 ~ pin 2
    EN ~ pin 3
    GPIO2_PZT_TL ~ pin 4
    GPIO3_PZT_TR ~ pin 5
    GPIO6_PZT_BL ~ pin 6
    GPIO7_PZT_BR ~ pin 7
    GPIO8_LED_DATA ~ pin 8
    GPIO9_BOOT ~ pin 9
    GPIO10_USER_BTN ~ pin 10
    PWR_LATCH ~ pin 11
    USB_DP ~ pin 13
    USB_DN ~ pin 16
    UART_TX ~ pin 24
    UART_RX ~ pin 25
    GND_28 ~ pin 28
    footprint = "SmartPaddle:SGFK_ESP32-C6-N8_CUTOUT"

component IM948_Cutout:
    designator_prefix = "U"
    pin GND_1
    pin VBUS
    pin VBAT_3
    pin VDDIO
    pin ADIN
    pin LED_B
    pin LED_R
    pin GPIO
    pin KEY
    pin RXD
    pin TXD
    pin VBAT_15
    pin GND_16

    GND_1 ~ pin 1
    VBUS ~ pin 2
    VBAT_3 ~ pin 3
    VDDIO ~ pin 4
    ADIN ~ pin 7
    LED_B ~ pin 9
    LED_R ~ pin 10
    GPIO ~ pin 11
    KEY ~ pin 12
    RXD ~ pin 13
    TXD ~ pin 14
    VBAT_15 ~ pin 15
    GND_16 ~ pin 16
    footprint = "SmartPaddle:IM948_CUTOUT"

module PZTDock:
    pin SIGNAL_PAD
    pin GND_PAD
    pin MCU_SIGNAL
    pin CLAMP_GND
    pin CLAMP_VCC

    signal pzt_raw
    signal pzt_mcu
    signal gnd
    signal vcc

    SIGNAL_PAD ~ pzt_raw
    MCU_SIGNAL ~ pzt_mcu
    GND_PAD ~ gnd
    CLAMP_GND ~ gnd
    CLAMP_VCC ~ vcc

    pzt_signal_pad = new WirePad
    pzt_gnd_pad = new WirePad
    series_resistor = new Resistor
    bleed_resistor = new Resistor
    clamp_diode = new BAT54S
    series_resistor.value = "4.7k"
    bleed_resistor.value = "1M"

    pzt_signal_pad.contact ~ SIGNAL_PAD
    pzt_gnd_pad.contact ~ GND_PAD
    series_resistor.p1 ~ pzt_raw
    series_resistor.p2 ~ MCU_SIGNAL
    bleed_resistor.p1 ~ pzt_raw
    bleed_resistor.p2 ~ CLAMP_GND
    clamp_diode.signal_node ~ MCU_SIGNAL
    clamp_diode.low_rail ~ CLAMP_GND
    clamp_diode.high_rail ~ CLAMP_VCC



module TailHarness:
    pin BAT_PLUS
    pin GND
    pin LED_PLUS
    pin LED_DIN
    pin BUTTON
    pin USB_VBUS
    pin USB_DP
    pin USB_DN

    bat_plus_pad = new EdgeFingerPad
    gnd_pad = new EdgeFingerPad
    led_plus_pad = new EdgeFingerPad
    led_din_pad = new EdgeFingerPad
    button_pad = new EdgeFingerPad
    usb_vbus_pad = new EdgeFingerPad
    usb_dp_pad = new EdgeFingerPad
    usb_dn_pad = new EdgeFingerPad

    bat_plus_pad.contact ~ BAT_PLUS
    gnd_pad.contact ~ GND
    led_plus_pad.contact ~ LED_PLUS
    led_din_pad.contact ~ LED_DIN
    button_pad.contact ~ BUTTON
    usb_vbus_pad.contact ~ USB_VBUS
    usb_dp_pad.contact ~ USB_DP
    usb_dn_pad.contact ~ USB_DN


module PowerLatchAndRegulator:
    pin VBAT_IN
    pin VBAT_SW
    pin VCC_3V3
    pin GND
    pin EN
    pin PWR_LATCH
    pin BUTTON_RAW
    pin BUTTON_GPIO
    pin P_GATE

    q_power = new PChannelMOSFET_SOT23
    q_latch = new NChannelMOSFET_SOT23
    r_gate = new Resistor
    r_button_series = new Resistor
    r_button_pullup = new Resistor
    r_latch_pd = new Resistor
    r_en_pullup = new Resistor
    d_button = new Diode
    ldo = new AP2112K_3V3
    c_in = new Capacitor
    c_out = new Capacitor
    r_gate.value = "100k"
    r_button_series.value = "1k"
    r_button_pullup.value = "10k"
    r_latch_pd.value = "100k"
    r_en_pullup.value = "10k"
    c_in.value = "10uF"
    c_out.value = "10uF"

    q_power.gate ~ P_GATE
    q_power.source ~ VBAT_IN
    q_power.drain ~ VBAT_SW

    q_latch.gate ~ PWR_LATCH
    q_latch.source ~ GND
    q_latch.drain ~ P_GATE

    r_gate.p1 ~ P_GATE
    r_gate.p2 ~ VBAT_IN
    r_button_series.p1 ~ BUTTON_RAW
    r_button_series.p2 ~ BUTTON_GPIO
    r_button_pullup.p1 ~ BUTTON_GPIO
    r_button_pullup.p2 ~ VCC_3V3
    r_latch_pd.p1 ~ PWR_LATCH
    r_latch_pd.p2 ~ GND
    r_en_pullup.p1 ~ EN
    r_en_pullup.p2 ~ VCC_3V3
    d_button.anode ~ P_GATE
    d_button.cathode ~ BUTTON_RAW

    ldo.vin ~ VBAT_SW
    ldo.en ~ VBAT_SW
    ldo.gnd ~ GND
    ldo.vout ~ VCC_3V3

    c_in.p1 ~ VBAT_SW
    c_in.p2 ~ GND
    c_out.p1 ~ VCC_3V3
    c_out.p2 ~ GND



module LEDInterface:
    pin LED_SUPPLY
    pin MCU_DATA
    pin LED_DIN
    pin GND

    r_data = new Resistor
    c_supply = new Capacitor
    r_data.value = "330R"
    c_supply.value = "100nF"

    r_data.p1 ~ MCU_DATA
    r_data.p2 ~ LED_DIN
    c_supply.p1 ~ LED_SUPPLY
    c_supply.p2 ~ GND



module TestPads:
    pin VBAT_SW
    pin VCC_3V3
    pin GND
    pin EN
    pin BOOT
    pin UART_TX
    pin UART_RX
    pin IMU_KEY
    pin IMU_GPIO
    pin PWR_LATCH
    pin LED_DATA
    pin VBUS
    pin IMU_VDDIO
    pin VBAT_SENSE

    vbat_pad = new SmallWirePad
    vcc_pad = new SmallWirePad
    gnd_pad = new SmallWirePad
    en_pad = new SmallWirePad
    boot_pad = new SmallWirePad
    uart_tx_pad = new SmallWirePad
    uart_rx_pad = new SmallWirePad
    imu_key_pad = new SmallWirePad
    imu_gpio_pad = new SmallWirePad
    pwr_latch_pad = new SmallWirePad
    led_data_pad = new SmallWirePad
    vbus_pad = new SmallWirePad
    imu_vddio_pad = new SmallWirePad
    vbat_sense_pad = new SmallWirePad

    vbat_pad.contact ~ VBAT_SW
    vcc_pad.contact ~ VCC_3V3
    gnd_pad.contact ~ GND
    en_pad.contact ~ EN
    boot_pad.contact ~ BOOT
    uart_tx_pad.contact ~ UART_TX
    uart_rx_pad.contact ~ UART_RX
    imu_key_pad.contact ~ IMU_KEY
    imu_gpio_pad.contact ~ IMU_GPIO
    pwr_latch_pad.contact ~ PWR_LATCH
    led_data_pad.contact ~ LED_DATA
    vbus_pad.contact ~ VBUS
    imu_vddio_pad.contact ~ IMU_VDDIO
    vbat_sense_pad.contact ~ VBAT_SENSE


module BatterySense:
    pin VBAT_SW
    pin GND
    pin SENSE

    r_top = new Resistor
    r_bottom = new Resistor
    c_filter = new Capacitor
    r_top.value = "1M"
    r_bottom.value = "1M"
    c_filter.value = "100nF"

    r_top.p1 ~ VBAT_SW
    r_top.p2 ~ SENSE
    r_bottom.p1 ~ SENSE
    r_bottom.p2 ~ GND
    c_filter.p1 ~ SENSE
    c_filter.p2 ~ GND



module SmartPaddleRigid:
    mcu = new SGFK_ESP32C6N8_Cutout
    imu = new IM948_Cutout
    power = new PowerLatchAndRegulator
    tail = new TailHarness
    bringup = new TestPads
    battery = new BatterySense

    # Inline LED interface components (atopile 0.2.x module nesting bug workaround)
    led_r_data = new Resistor
    led_c_supply = new Capacitor
    led_r_data.value = "330R"
    led_c_supply.value = "100nF"

    pzt_tr = new PZTDock
    pzt_tl = new PZTDock
    pzt_br = new PZTDock
    pzt_bl = new PZTDock

    signal gnd
    signal vbat_in
    signal vbat_sw
    signal vcc
    signal en
    signal usb_dp
    signal usb_dn
    signal uart_tx
    signal uart_rx
    signal led_data
    signal led_din
    signal btn_sw
    signal boot_btn
    signal user_btn
    signal pwr_latch
    signal p_gate
    signal imu_key
    signal imu_gpio
    signal imu_vddio
    signal vbat_sense
    signal vbus

    signal pzt_tr_signal
    signal pzt_tl_signal
    signal pzt_br_signal
    signal pzt_bl_signal

    # Power rails.
    tail.BAT_PLUS ~ vbat_in
    tail.GND ~ gnd
    power.VBAT_IN ~ vbat_in
    power.VBAT_SW ~ vbat_sw
    power.VCC_3V3 ~ vcc
    power.GND ~ gnd
    mcu.VCC_3V3 ~ vcc
    mcu.GND_1 ~ gnd
    mcu.GND_28 ~ gnd

    # IM948 module power and UART link.
    imu.VBAT_3 ~ vbat_sw
    imu.VBAT_15 ~ vbat_sw
    imu.VBUS ~ vbus
    imu.GND_1 ~ gnd
    imu.GND_16 ~ gnd
    # IM948 VDDIO is kept as its own IO-reference net per the module notes:
    # VBAT > 3.1V makes the module's internal LDO drive it around 3.0V.
    # Tying it hard to the ESP32 3V3 rail may fight that internal regulator.
    imu.VDDIO ~ imu_vddio
    imu.ADIN ~ vbat_sense
    imu.RXD ~ uart_tx
    imu.TXD ~ uart_rx
    imu.KEY ~ imu_key
    imu.GPIO ~ imu_gpio
    mcu.UART_TX ~ uart_tx
    mcu.UART_RX ~ uart_rx

    # ESP32-C6 control, programming, and user input.
    mcu.EN ~ en
    power.EN ~ en
    mcu.GPIO9_BOOT ~ boot_btn
    mcu.GPIO10_USER_BTN ~ user_btn
    mcu.PWR_LATCH ~ pwr_latch
    power.PWR_LATCH ~ pwr_latch
    power.P_GATE ~ p_gate
    tail.BUTTON ~ btn_sw
    power.BUTTON_RAW ~ btn_sw
    power.BUTTON_GPIO ~ user_btn

    # External USB pads for serial/programming/debug.
    tail.USB_VBUS ~ vbus
    tail.USB_DP ~ usb_dp
    tail.USB_DN ~ usb_dn
    mcu.USB_DP ~ usb_dp
    mcu.USB_DN ~ usb_dn

    # External WS2812B-style LED wire interface.
    tail.LED_PLUS ~ vbat_sw
    tail.LED_DIN ~ led_din
    led_c_supply.p1 ~ vbat_sw
    led_c_supply.p2 ~ gnd
    led_r_data.p1 ~ led_data
    led_r_data.p2 ~ led_din
    mcu.GPIO8_LED_DATA ~ led_data

    # Switched battery measurement for low-battery LED feedback.
    battery.VBAT_SW ~ vbat_sw
    battery.GND ~ gnd
    battery.SENSE ~ vbat_sense

    # Bench bring-up pads. These are not intended as permanent user-facing
    # connectors; they keep early firmware and power checks accessible.
    bringup.VBAT_SW ~ vbat_sw
    bringup.VCC_3V3 ~ vcc
    bringup.GND ~ gnd
    bringup.EN ~ en
    bringup.BOOT ~ boot_btn
    bringup.UART_TX ~ uart_tx
    bringup.UART_RX ~ uart_rx
    bringup.IMU_KEY ~ imu_key
    bringup.IMU_GPIO ~ imu_gpio
    bringup.PWR_LATCH ~ pwr_latch
    bringup.LED_DATA ~ led_data
    bringup.VBUS ~ vbus
    bringup.IMU_VDDIO ~ imu_vddio
    bringup.VBAT_SENSE ~ vbat_sense

    # Four PZT docks. The small front-end parts live at each dock.
    mcu.GPIO3_PZT_TR ~ pzt_tr_signal
    pzt_tr.MCU_SIGNAL ~ pzt_tr_signal
    pzt_tr.gnd ~ gnd
    pzt_tr.vcc ~ vcc

    mcu.GPIO2_PZT_TL ~ pzt_tl_signal
    pzt_tl.MCU_SIGNAL ~ pzt_tl_signal
    pzt_tl.gnd ~ gnd
    pzt_tl.vcc ~ vcc

    mcu.GPIO7_PZT_BR ~ pzt_br_signal
    pzt_br.MCU_SIGNAL ~ pzt_br_signal
    pzt_br.gnd ~ gnd
    pzt_br.vcc ~ vcc

    mcu.GPIO6_PZT_BL ~ pzt_bl_signal
    pzt_bl.MCU_SIGNAL ~ pzt_bl_signal
    pzt_bl.gnd ~ gnd
    pzt_bl.vcc ~ vcc
